+/// <summary>
+/// Keeps the solution loaded only while tool calls use it (<c>--idle-unload-seconds</c>): a call loads it when
+/// nothing is loaded, and once no call has run for the idle time the workspace is unloaded so its memory goes
+/// back to the system. Every tool call passes through <see cref="TrackAsync"/>, so an unload never lands while
+/// a call is running.
+/// </summary>
+internal sealed class WorkspaceIdleUnloader(WorkspaceService workspace, TimeSpan idle, ILogger<WorkspaceIdleUnloader> log)
+    : IDisposable
+{
+    private readonly object _lock = new();
+    private int _activeCalls;
+    private long _callsStarted; // a timer armed before a later call started is stale
+    private Timer? _timer;
+
+    public async ValueTask<CallToolResult> TrackAsync(
+        string? toolName, Func<ValueTask<CallToolResult>> invoke, CancellationToken ct)
+    {
+        lock (_lock)
+        {
+            _activeCalls++;
+            _callsStarted++;
+            _timer?.Dispose();
+            _timer = null;
+        }
+        try
+        {
+            // reload_workspace loads by itself; loading first would load the solution twice.
+            if (toolName != "reload_workspace")
+            {
+                try { await workspace.EnsureLoadedAsync(ct); }
+                catch (OperationCanceledException) { throw; }
+                catch (Exception ex)
+                {
+                    log.LogWarning(ex, "Loading the workspace failed");
+                    return new CallToolResult
+                    {
+                        IsError = true,
+                        Content = [new TextContentBlock { Text = $"WORKSPACE_LOAD_FAILED: {ex.Message}" }],
+                    };
+                }
+            }
+            return await invoke();
+        }
+        finally
+        {
+            lock (_lock)
+            {
+                if (--_activeCalls == 0)
+                {
+                    var calls = _callsStarted;
+                    _timer = new Timer(_ => _ = UnloadIfIdleAsync(calls), null, idle, Timeout.InfiniteTimeSpan);
+                }
+            }
+        }
+    }
+
+    private bool IsIdleSince(long calls)
+    {
+        lock (_lock) return _activeCalls == 0 && _callsStarted == calls;
+    }
+
+    private async Task UnloadIfIdleAsync(long calls)
+    {
+        try
+        {
+            if (!await workspace.UnloadAsync(() => IsIdleSince(calls))) return;
+            ReleaseMemory();
+        }
+        catch (Exception ex)
+        {
+            log.LogWarning(ex, "Unloading the idle workspace failed");
+        }
+    }
+
+    /// <summary>
+    /// The unloaded solution stays in the GC heap until a collection; an aggressive one also gives the memory back
+    /// to the system. It runs here, after <see cref="WorkspaceService.UnloadAsync"/> returned: inside that async
+    /// method its own locals still reach the disposed generations, so a collection there frees almost nothing.
+    /// </summary>
+    private void ReleaseMemory()
+    {
+        GCSettings.LargeObjectHeapCompactionMode = GCLargeObjectHeapCompactionMode.CompactOnce;
+        GC.Collect(GC.MaxGeneration, GCCollectionMode.Aggressive, blocking: true, compacting: true);
+        using var process = System.Diagnostics.Process.GetCurrentProcess();
+        log.LogInformation("Unloaded the workspace after {Idle} without tool calls: GC heap {Heap} MiB, private memory {Private} MiB",
+            idle, GC.GetGCMemoryInfo().HeapSizeBytes >> 20, process.PrivateMemorySize64 >> 20);
+    }
+
+    public void Dispose()
+    {
+        lock (_lock)
+        {
+            _timer?.Dispose();
+            _timer = null;
+        }
+    }
+}

+
+        try
+        {
+            await using (var client = await McpClient.CreateAsync(new StdioClientTransport(new StdioClientTransportOptions
+            {
+                Name = "mcpRoslyn",
+                Command = exe,
+                Arguments = ["--solution", FixturePaths.TestSolutionPath, "--idle-unload-seconds", "1", "--log-file", logFile],
+            })))
+            {
+                Loads().Should().Be(0, "nothing loads before the first tool call");
+
+                var first = await FindReferencesAsync(client);
+                first.IsError.Should().NotBe(true, Text(first));
+                Loads().Should().Be(1);
+
+                var deadline = DateTime.UtcNow + TimeSpan.FromSeconds(60);
+                while (!ReadLog().Contains("Unloaded the workspace"))
+                {
+                    if (DateTime.UtcNow > deadline) Assert.Fail("One idle second did not unload the workspace within 60 s");
+                    await Task.Delay(50);
+                }
+
+                var second = await FindReferencesAsync(client);
+                second.IsError.Should().NotBe(true, Text(second));
+                Loads().Should().Be(2, "the call after the unload loads the solution again");
+            }
+        }
+        finally
+        {
+            // The server may still be exiting and holding its log; a leftover temp file is harmless.
+            try { File.Delete(logFile); }
+            catch (IOException) { }
+        }
+

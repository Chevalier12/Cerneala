<Project Sdk="Microsoft.NET.Sdk">

  <!-- Isolated stage-0 probe of the Timbre decoder candidates (plan
       docs/plans/2026-10-03-timbre-decoding-streaming.md). Outside the
       production globs; not part of Cerneala.slnx. Prototype/ is the stage-0
       snapshot that produced the selection evidence (it uses the NLayer 3.0.0
       package as published); production lives in Timbre/Decoding, with NLayer
       vendored and fixed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.OggFile" Version="1.0.7" />
    <PackageReference Include="NAudio.Core" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\Fixtures\TimbreCorpusGenerator\CorpusSignal.cs" Link="CorpusSignal.cs" />
  </ItemGroup>

</Project>

fragment main0_out main0(main0_in in [[stage_in]], constant type_PrismFragmentUniforms& PrismFragmentUniforms [[buffer(0)]], texture2d<float> SpriteTexture [[texture(0)]], sampler SpriteTextureSampler [[sampler(0)]])

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryRoot>$(MSBuildProjectDirectory)\..</RepositoryRoot>
    <SdlShaderCompilerProject>$(RepositoryRoot)\Tools\Cerneala.SdlShaderCompiler\Cerneala.SdlShaderCompiler.csproj</SdlShaderCompilerProject>
    <SdlShaderCompilerAssets>$(RepositoryRoot)\Tools\Cerneala.SdlShaderCompiler\obj\project.assets.json</SdlShaderCompilerAssets>
    <SdlShaderManifest>$(MSBuildProjectDirectory)\Shaders\manifest.json</SdlShaderManifest>
    <SdlShaderMetadata>$(MSBuildProjectDirectory)\Shaders\artifacts.json</SdlShaderMetadata>
    <SdlShaderVerifyStamp>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\sdl-shaders.verify.stamp</SdlShaderVerifyStamp>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cerneala.csproj" />
    <ProjectReference Include="..\Cerneala.Platforms.Sdl3\Cerneala.Platforms.Sdl3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <SdlShaderInput Include="$(SdlShaderManifest)" />
    <SdlShaderInput Include="$(MSBuildProjectDirectory)\Gpu\Shaders\*.hlsl" />
    <SdlShaderInput Include="$(MSBuildProjectDirectory)\Prism\Shaders\*.hlsl" />
    <SdlShaderInput Include="$(RepositoryRoot)\Drawing\Prism\Shaders\Hlsl\**\*.hlsl" />
    <SdlShaderInput Include="$(SdlShaderCompilerProject)" />
    <SdlShaderInput Include="$(RepositoryRoot)\Tools\Cerneala.SdlShaderCompiler\Program.cs" />
    <SdlShaderArtifact Include="$(MSBuildProjectDirectory)\Gpu\Shaders\*.dxil" />
    <SdlShaderArtifact Include="$(MSBuildProjectDirectory)\Gpu\Shaders\*.spv" />
    <SdlShaderArtifact Include="$(MSBuildProjectDirectory)\Gpu\Shaders\*.msl" />
    <SdlShaderArtifact Include="$(MSBuildProjectDirectory)\Prism\Shaders\*.dxil" />
    <SdlShaderArtifact Include="$(MSBuildProjectDirectory)\Prism\Shaders\*.spv" />
    <SdlShaderArtifact Include="$(MSBuildProjectDirectory)\Prism\Shaders\*.msl" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cerneala.Benchmarks" />
    <InternalsVisibleTo Include="Cerneala.Tests" />
    <InternalsVisibleTo Include="Cerneala.Tests.SdlGpu" />
    <InternalsVisibleTo Include="Cerneala.Tests.SceneVillage" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Gpu\Shaders\Drawing.vert.dxil" />
    <EmbeddedResource Include="Gpu\Shaders\Drawing.vert.spv" />
    <EmbeddedResource Include="Gpu\Shaders\Drawing.vert.msl" />
    <EmbeddedResource Include="Gpu\Shaders\Drawing.frag.dxil" />
    <EmbeddedResource Include="Gpu\Shaders\Drawing.frag.spv" />
    <EmbeddedResource Include="Gpu\Shaders\Drawing.frag.msl" />
    <EmbeddedResource Include="Gpu\Shaders\DrawingImageDomain.vert.dxil" />
    <EmbeddedResource Include="Gpu\Shaders\DrawingImageDomain.vert.spv" />
    <EmbeddedResource Include="Gpu\Shaders\DrawingImageDomain.vert.msl" />
    <EmbeddedResource Include="Gpu\Shaders\DrawingImageDomain.frag.dxil" />
    <EmbeddedResource Include="Gpu\Shaders\DrawingImageDomain.frag.spv" />
    <EmbeddedResource Include="Gpu\Shaders\DrawingImageDomain.frag.msl" />
    <EmbeddedResource Include="Gpu\Shaders\Surface3D.vert.dxil" />
    <EmbeddedResource Include="Gpu\Shaders\Surface3D.vert.spv" />
    <EmbeddedResource Include="Gpu\Shaders\Surface3D.vert.msl" />
    <EmbeddedResource Include="Gpu\Shaders\Surface3D.frag.dxil" />
    <EmbeddedResource Include="Gpu\Shaders\Surface3D.frag.spv" />
    <EmbeddedResource Include="Gpu\Shaders\Surface3D.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\Prism.vert.dxil" />
    <EmbeddedResource Include="Prism\Shaders\Prism.vert.spv" />
    <EmbeddedResource Include="Prism\Shaders\Prism.vert.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCopy.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCopy.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCopy.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismComposite.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismComposite.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismComposite.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismNeighborhood.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismNeighborhood.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismNeighborhood.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismResampling.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismResampling.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismResampling.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogArtistic.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogArtistic.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogArtistic.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogProcedural.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogProcedural.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogProcedural.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogSpatial.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogSpatial.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogSpatial.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters10To14.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters10To14.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters10To14.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters15To20.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters15To20.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters15To20.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters21To26.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters21To26.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters21To26.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters27To32.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters27To32.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters27To32.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters33To39.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters33To39.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters33To39.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismStyle.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismStyle.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismStyle.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters89To97.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters89To97.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismCatalogFilters89To97.frag.msl" />
    <EmbeddedResource Include="Prism\Shaders\PrismPresentation.frag.dxil" />
    <EmbeddedResource Include="Prism\Shaders\PrismPresentation.frag.spv" />
    <EmbeddedResource Include="Prism\Shaders\PrismPresentation.frag.msl" />
  </ItemGroup>

  <Target Name="RestoreSdlShaderCompiler"
          Inputs="$(SdlShaderCompilerProject)"
          Outputs="$(SdlShaderCompilerAssets)"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet restore &quot;$(SdlShaderCompilerProject)&quot; --nologo"
          WorkingDirectory="$(RepositoryRoot)" />
  </Target>

  <Target Name="VerifySdlShaderArtifacts"
          BeforeTargets="PrepareResources"
          DependsOnTargets="RestoreSdlShaderCompiler"
          Inputs="@(SdlShaderInput)"
          Outputs="$(SdlShaderVerifyStamp)"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'@(SdlShaderArtifact)' == ''"
           Text="No versioned SDL_GPU shader artifacts were found." />
    <Exec Command="dotnet run --project &quot;$(SdlShaderCompilerProject)&quot; --no-restore -- --verify --manifest &quot;$(SdlShaderManifest)&quot;"
          WorkingDirectory="$(RepositoryRoot)" />
    <!-- Under an artifacts layout the default obj\<Configuration>\<TFM>\ folder is not created. -->
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SdlShaderVerifyStamp)'))" />
    <Touch Files="$(SdlShaderVerifyStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="RequireSdlShaderArtifacts"
          BeforeTargets="PrepareResources"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('%(SdlShaderArtifact.FullPath)')"
           Text="SDL_GPU shader artifact '%(SdlShaderArtifact.FullPath)' is missing or stale." />
    <Error Condition="!Exists('$(SdlShaderMetadata)')"
           Text="SDL_GPU shader metadata '$(SdlShaderMetadata)' is missing or stale." />
  </Target>

</Project>

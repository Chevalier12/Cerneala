<UserControl>
    <UserControl.Resources>
        <Aspect Name="AspectStudioGhostButton" TargetType="Button">
            @default
            {
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 9;
                Background = "#00000000";
                Foreground = "#FFEDEFF3";
                BorderBrush = "#FF424754";
                BorderThickness = "1";
            }
            @when IsMouseOver
            {
                Background = "#FF10282D";
                Foreground = "#FF4DF0FF";
                BorderBrush = "#FF4DF0FF";
            }
        </Aspect>
    </UserControl.Resources>
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    Text="04 / ASPECT STUDIO"
                    FontFamily="Cascadia Mono SemiBold"
                    FontSize="10"
                    Foreground="$OrangeBrush" />
                <TextBlock
                    Text="Border. TextBlock. Button."
                    FontFamily="Bahnschrift SemiBold"
                    FontSize="25"
                    Margin="0,5,0,0" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Aspect="$AspectStudioGhostButton"
                Content="RESET CURRENT"
                Click="OnReset"
                Padding="14,8,14,8"
                VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="174" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="352" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="ELEMENT"
                    FontFamily="Cascadia Mono SemiBold"
                    FontSize="9"
                    Foreground="$CyanBrush"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Row="1">
                    <Button
                        Name="BorderElementButton"
                        Aspect="$AspectStudioGhostButton"
                        Content="BORDER"
                        Click="OnSelectBorder"
                        Padding="10,11,10,11"
                        Margin="0,0,0,7" />
                    <Button
                        Name="TextBlockElementButton"
                        Aspect="$AspectStudioGhostButton"
                        Content="TEXTBLOCK"
                        Click="OnSelectTextBlock"
                        Padding="10,11,10,11"
                        Margin="0,0,0,7" />
                    <Button
                        Name="ButtonElementButton"
                        Aspect="$AspectStudioGhostButton"
                        Content="BUTTON"
                        Click="OnSelectButton"
                        Padding="10,11,10,11" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        Text="LIVE PREVIEW"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="9"
                        Foreground="$LimeBrush"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Name="PreviewTypeText"
                        Text="BORDER / LOCAL ASPECT"
                        FontFamily="Cascadia Mono"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <Border
                    Name="PreviewStage"
                    Grid.Row="1"
                    Background="$PanelAltBrush"
                    BorderBrush="$LineStrongBrush"
                    BorderThickness="1"
                    Padding="28"
                    ClipToBounds="True" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        Text="PROPERTIES"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="9"
                        Foreground="$PinkBrush"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Name="PropertyCountText"
                        Text="00 EDITABLE"
                        FontFamily="Cascadia Mono"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="FILTER"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        VerticalAlignment="Center" />
                    <TextBox
                        Name="PropertySearch"
                        Grid.Column="1"
                        TextChanged="OnPropertySearchChanged"
                        Background="$PanelBrush"
                        BorderBrush="$LineStrongBrush"
                        BorderThickness="1"
                        Foreground="$PaperBrush"
                        CaretBrush="$CyanBrush"
                        FontFamily="Cascadia Mono"
                        FontSize="9"
                        Padding="7,5,7,5" />
                </Grid>
                <AspectStudioScrollHost
                    Name="PropertyHost"
                    Grid.Row="2"
                    Background="$PanelAltBrush"
                    BorderBrush="$LineStrongBrush"
                    BorderThickness="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" />
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="$LineBrush" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Name="StatusElement"
                    Text="BORDER"
                    FontFamily="Cascadia Mono"
                    FontSize="8"
                    Foreground="$CyanBrush"
                    Margin="0,0,18,0" />
                <TextBlock
                    Name="StatusModified"
                    Grid.Column="1"
                    Text="MODIFIED 00"
                    FontFamily="Cascadia Mono"
                    FontSize="8"
                    Foreground="$LimeBrush"
                    Margin="0,0,18,0" />
                <TextBlock
                    Name="StatusMessage"
                    Grid.Column="2"
                    Text="READY"
                    FontFamily="Cascadia Mono"
                    FontSize="8"
                    Foreground="$SlateBrush"
                    HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

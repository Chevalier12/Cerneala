<UserControl xmlns:studio="clr-namespace:Cerneala.Presentation">
    <UserControl.Resources>
        <Aspect Name="AspectStudioGhostButton" TargetType="Button">
            @default
            {
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 9;
                Background = "#00000000";
                Foreground = "#FFEDEFF3";
                BorderBrush = "#FF424754";
                BorderThickness = "1";
            }
            @when IsMouseOver
            {
                Background = "#FF10282D";
                Foreground = "#FF4DF0FF";
                BorderBrush = "#FF4DF0FF";
            }
        </Aspect>
        <Aspect Name="AspectStudioTextInput" TargetType="TextBox">
            @default
            {
                Background = "#FF14181E";
                BorderBrush = "#FF343C46";
                BorderThickness = "1";
                Foreground = "#FFEDEFF3";
                CaretBrush = "#FF4DF0FF";
                FontFamily = "Cascadia Mono";
                FontSize = 8;
                Padding = "6,5,6,5";
            }
        </Aspect>
        <Aspect Name="AspectStudioComboInput" TargetType="ComboBox">
            @default
            {
                Background = "#FF14181E";
                BorderBrush = "#FF343C46";
                BorderThickness = "1";
                Foreground = "#FFEDEFF3";
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 8;
                Padding = "7,5,7,5";
                MaxDropDownHeight = 180;
            }
        </Aspect>
        <Aspect TargetType="ColorPicker">
            @default
            {
                Background = "#FF14181E";
                Foreground = "#FFEDEFF3";
                BorderBrush = "#FF343C46";
                BorderThickness = "1";
                Padding = "8";
            }
        </Aspect>
    </UserControl.Resources>
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    Text="04 / ASPECT STUDIO"
                    FontFamily="Cascadia Mono SemiBold"
                    FontSize="10"
                    Foreground="$OrangeBrush" />
                <TextBlock
                    Text="Border. TextBlock. Button."
                    FontFamily="Bahnschrift SemiBold"
                    FontSize="25"
                    Margin="0,5,0,0" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Aspect="$AspectStudioGhostButton"
                Content="RESET CURRENT"
                Click="OnReset"
                Padding="14,8,14,8"
                VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="174" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="352" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="ELEMENT"
                    FontFamily="Cascadia Mono SemiBold"
                    FontSize="9"
                    Foreground="$CyanBrush"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Row="1">
                    <Button
                        Name="BorderElementButton"
                        Aspect="$AspectStudioGhostButton"
                        Content="BORDER"
                        Click="OnSelectBorder"
                        Padding="10,11,10,11"
                        Margin="0,0,0,7" />
                    <Button
                        Name="TextBlockElementButton"
                        Aspect="$AspectStudioGhostButton"
                        Content="TEXTBLOCK"
                        Click="OnSelectTextBlock"
                        Padding="10,11,10,11"
                        Margin="0,0,0,7" />
                    <Button
                        Name="ButtonElementButton"
                        Aspect="$AspectStudioGhostButton"
                        Content="BUTTON"
                        Click="OnSelectButton"
                        Padding="10,11,10,11" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        Text="LIVE PREVIEW"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="9"
                        Foreground="$LimeBrush"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Name="PreviewTypeText"
                        Text="BORDER / LOCAL ASPECT"
                        FontFamily="Cascadia Mono"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <Border
                    Name="PreviewStage"
                    Grid.Row="1"
                    Background="$PanelAltBrush"
                    BorderBrush="$LineStrongBrush"
                    BorderThickness="1"
                    Padding="28"
                    ClipToBounds="True">
                    <Grid>
                        <Grid Name="BorderPreviewHost">
                            <Border
                                Name="BorderPreview"
                                Width="260"
                                Height="180"
                                Background="#FF1B222A"
                                BorderBrush="#FF4DF0FF"
                                BorderThickness="2"
                                Padding="24"
                                FontFamily="Cascadia Mono SemiBold"
                                FontSize="12"
                                Foreground="#FFEDEFF3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="BORDER"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Grid Name="TextBlockPreviewHost" Visibility="Collapsed">
                            <TextBlock
                                Name="TextBlockPreview"
                                Text="Cerneala, live."
                                Width="320"
                                FontFamily="Bahnschrift SemiBold"
                                FontSize="30"
                                Foreground="#FFEDEFF3"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                        <Grid Name="ButtonPreviewHost" Visibility="Collapsed">
                            <Button
                                Name="ButtonPreview"
                                Content="APLICA ASPECT"
                                Background="#FFC6FF3D"
                                Foreground="#FF0A0B0E"
                                BorderBrush="#FFC6FF3D"
                                BorderThickness="1"
                                Padding="22,13,22,13"
                                FontFamily="Cascadia Mono SemiBold"
                                FontSize="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="True"
                                IsTabStop="True" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        Text="PROPERTIES"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="9"
                        Foreground="$PinkBrush"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Name="PropertyCountText"
                        Text="00 EDITABLE"
                        FontFamily="Cascadia Mono"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="FILTER"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        VerticalAlignment="Center" />
                    <TextBox
                        Name="PropertySearch"
                        Grid.Column="1"
                        TextChanged="OnPropertySearchChanged"
                        Background="$PanelBrush"
                        BorderBrush="$LineStrongBrush"
                        BorderThickness="1"
                        Foreground="$PaperBrush"
                        CaretBrush="$CyanBrush"
                        FontFamily="Cascadia Mono"
                        FontSize="9"
                        Padding="7,5,7,5" />
                </Grid>
                <ScrollViewer
                    Name="PropertyHost"
                    Grid.Row="2"
                    Background="$PanelAltBrush"
                    BorderBrush="$LineStrongBrush"
                    BorderThickness="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl
                        Name="PropertyItems"
                        ItemsSource="$root.PropertyRows:OneWay"
                        Margin="9">
                        <ItemsControl.ItemsPanel>
                            <VirtualizingStackPanel />
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Templates>
                            <ContentTemplate DataType="studio:AspectStudioHeaderRow">
                                <TextBlock
                                    Text="$DataContext.Label"
                                    Foreground="$DataContext.LabelBrush"
                                    FontFamily="Cascadia Mono SemiBold"
                                    FontSize="8"
                                    Margin="0,8,0,4" />
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:AspectStudioTextRow">
                                <Border BorderBrush="#FF343C46" BorderThickness="0,1,0,0" Padding="8,7,8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="126" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="$DataContext.Label"
                                            Foreground="$DataContext.LabelBrush"
                                            FontFamily="Cascadia Mono"
                                            FontSize="8"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0" />
                                        <TextBox
                                            Grid.Column="1"
                                            Aspect="$AspectStudioTextInput"
                                            AutomationProperties.AutomationId="$DataContext.AutomationId"
                                            Text="$DataContext.Text:TwoWay"
                                            BorderBrush="$DataContext.BorderBrush" />
                                    </Grid>
                                </Border>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:AspectStudioBooleanRow">
                                <Border BorderBrush="#FF343C46" BorderThickness="0,1,0,0" Padding="8,7,8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="126" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="$DataContext.Label"
                                            Foreground="$DataContext.LabelBrush"
                                            FontFamily="Cascadia Mono"
                                            FontSize="8"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0" />
                                        <CheckBox
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="$DataContext.AutomationId"
                                            Width="24"
                                            Height="24"
                                            HorizontalAlignment="Left"
                                            IsChecked="$DataContext.IsChecked:TwoWay" />
                                    </Grid>
                                </Border>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:AspectStudioChoiceRow">
                                <Border BorderBrush="#FF343C46" BorderThickness="0,1,0,0" Padding="8,7,8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="126" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="$DataContext.Label"
                                            Foreground="$DataContext.LabelBrush"
                                            FontFamily="Cascadia Mono"
                                            FontSize="8"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Aspect="$AspectStudioComboInput"
                                            AutomationProperties.AutomationId="$DataContext.AutomationId"
                                            ItemsSource="$DataContext.Items"
                                            SelectedIndex="$DataContext.SelectedIndex:TwoWay" />
                                    </Grid>
                                </Border>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:AspectStudioColorRow">
                                <Border BorderBrush="#FF343C46" BorderThickness="0,1,0,0" Padding="8,7,8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="126" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="$DataContext.Label"
                                            Foreground="$DataContext.LabelBrush"
                                            FontFamily="Cascadia Mono"
                                            FontSize="8"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ColorSwatch
                                                AutomationProperties.AutomationId="$DataContext.SwatchAutomationId"
                                                Width="20"
                                                Height="20"
                                                BorderBrush="#FF343C46"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                SelectedColor="$DataContext.SelectedColor:TwoWay" />
                                            <TextBox
                                                Grid.Column="1"
                                                Aspect="$AspectStudioTextInput"
                                                AutomationProperties.AutomationId="$DataContext.AutomationId"
                                                Text="$DataContext.Text:TwoWay"
                                                BorderBrush="$DataContext.BorderBrush"
                                                Margin="0" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </ContentTemplate>
                        </ItemsControl.Templates>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="$LineBrush" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Name="StatusElement"
                    Text="BORDER"
                    FontFamily="Cascadia Mono"
                    FontSize="8"
                    Foreground="$CyanBrush"
                    Margin="0,0,18,0" />
                <TextBlock
                    Name="StatusModified"
                    Grid.Column="1"
                    Text="MODIFIED 00"
                    FontFamily="Cascadia Mono"
                    FontSize="8"
                    Foreground="$LimeBrush"
                    Margin="0,0,18,0" />
                <TextBlock
                    Name="StatusMessage"
                    Grid.Column="2"
                    Text="READY"
                    FontFamily="Cascadia Mono"
                    FontSize="8"
                    Foreground="$SlateBrush"
                    HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

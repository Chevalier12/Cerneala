<UserControl xmlns:studio="clr-namespace:Cerneala.Presentation">
    <UserControl.Resources>
        <Aspect
            Name="PrismStudioGhostButton"
            TargetType="Button">
            @default
            {
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 9;
                Background = "#00000000";
                Foreground = "#FFEDEFF3";
                BorderBrush = "#FF424754";
                BorderThickness = "1";
            }
            @when IsMouseOver
            {
                Background = "#FF10282D";
                Foreground = "#FF4DF0FF";
                BorderBrush = "#FF4DF0FF";
            }
        </Aspect>
        <Aspect
            Name="PrismStudioPrimaryButton"
            TargetType="Button">
            @default
            {
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 9;
                Background = "#FFC6FF3D";
                Foreground = "#FF0A0B0E";
                BorderBrush = "#FFC6FF3D";
                BorderThickness = "1";
            }
            @when IsMouseOver
            {
                Background = "#FF4DF0FF";
                BorderBrush = "#FF4DF0FF";
            }
        </Aspect>
        <Aspect
            Name="PrismStudioCatalogButton"
            TargetType="Button">
            @default
            {
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 9;
                Background = "#00000000";
                Foreground = "#FFEDEFF3";
                BorderBrush = "#FF424754";
                BorderThickness = "1";
                Padding = "6,4,6,4";
            }
            @when IsMouseOver
            {
                Background = "#FF10282D";
                Foreground = "#FF4DF0FF";
                BorderBrush = "#FF4DF0FF";
            }
        </Aspect>
        <Aspect
            Name="PrismStudioButton"
            TargetType="Button">
            @default
            {
                Background = "#FF14181E";
                BorderBrush = "#FF343C46";
                BorderThickness = "1";
                Foreground = "#FFE8EBE8";
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 9;
                Padding = "7,6,7,6";
                Margin = "0,0,3,3";
            }
            @when IsMouseOver
            {
                Background = "#FF14373D";
                BorderBrush = $CyanBrush;
            }
        </Aspect>
        <Aspect
            Name="PrismStudioTextBox"
            TargetType="TextBox">
            @default
            {
                Background = "#FF14181E";
                BorderBrush = "#FF343C46";
                BorderThickness = "1";
                Foreground = "#FFE8EBE8";
                CaretBrush = "#FFFFFFFF";
                FontFamily = "Cascadia Mono";
                FontSize = 9;
                Padding = "6,5,6,5";
                Margin = "0,3,0,3";
            }
        </Aspect>
        <Aspect
            Name="PrismStudioCheckBox"
            TargetType="CheckBox">
            @default
            {
                Width = 22;
                Height = 22;
                Margin = "0,0,4,3";
            }
        </Aspect>
        <Aspect
            Name="PrismStudioComboBox"
            TargetType="ComboBox">
            @default
            {
                Background = "#FF14181E";
                BorderBrush = "#FF343C46";
                BorderThickness = "1";
                Foreground = "#FFE8EBE8";
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 9;
                Padding = "7,6,7,6";
                Margin = "0,0,3,3";
                MaxDropDownHeight = 180;
            }
        </Aspect>
        <Aspect
            Name="PrismStudioSelectionButton"
            TargetType="ToggleButton">
            @default
            {
                Background = "#FF14181E";
                BorderBrush = "#FF343C46";
                BorderThickness = "1";
                Foreground = "#FFE8EBE8";
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 8;
                Padding = "7,6,7,6";
                Margin = "0,0,3,3";
            }
            @when IsChecked
            {
                Background = "#FF14373D";
                BorderBrush = $CyanBrush;
                Foreground = $CyanBrush;
            }
            @when IsMouseOver
            {
                BorderBrush = $CyanBrush;
            }
        </Aspect>
        <Aspect
            Name="PrismStudioSliderThumb"
            TargetType="Thumb">
            @default
            {
                Background = "#FF4DF0FF";
                BorderBrush = "#FFE8EBE8";
                BorderThickness = "1";
            }
            @when IsMouseOver
            {
                Background = "#FFC6FF3D";
            }
        </Aspect>
        <Aspect
            Name="PrismStudioSliderTrack"
            TargetType="Track">
            @default
            {
                Background = "#FF21272F";
                BorderBrush = "#FF343C46";
                BorderThickness = "1";
            }
            @template
            {
                <Border
                    Background="$owner.Background"
                    BorderBrush="$owner.BorderBrush"
                    BorderThickness="$owner.BorderThickness">
                    <TrackLayoutPanel Orientation="$owner.Orientation">
                        <Thumb
                            Name="PART_Thumb"
                            Aspect="$PrismStudioSliderThumb" />
                    </TrackLayoutPanel>
                </Border>
            }
        </Aspect>
        <Aspect
            Name="PrismStudioSlider"
            TargetType="Slider">
            @default
            {
                Height = 20;
            }
            @template
            {
                <Track
                    Name="PART_Track"
                    Aspect="$PrismStudioSliderTrack" />
            }
        </Aspect>
    </UserControl.Resources>
    <Grid
        Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    Text="06 / PRISM STUDIO"
                    FontFamily="Cascadia Mono SemiBold"
                    FontSize="10"
                    Foreground="$PinkBrush" />
                <TextBlock
                    Text="Composite the retained tree."
                    FontFamily="Bahnschrift SemiBold"
                    FontSize="25"
                    Margin="0,5,0,0" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Aspect="$PrismStudioGhostButton"
                Content="RESET"
                Click="OnReset"
                Background="$PanelAltBrush"
                BorderBrush="$LineStrongBrush"
                BorderThickness="1"
                Padding="14,8,14,8"
                VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" />
                <ColumnDefinition Width="0.78*" />
                <ColumnDefinition Width="1.10*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="0"
                Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        Text="LIVE PREVIEW"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="9"
                        Foreground="$CyanBrush"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="RENDER-OWNING TARGET"
                        FontFamily="Cascadia Mono"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <Border
                    Grid.Row="1"
                    Background="$PanelAltBrush"
                    BorderBrush="$LineStrongBrush"
                    BorderThickness="1"
                    Padding="18">
                    <Grid
                        ClipToBounds="True">
                        <Border
                            Name="PreviewMascot"
                            Background="#FF11151B"
                            BorderBrush="$CyanBrush"
                            BorderThickness="1">
                            <Grid>
                                <SvgImage
                                    Name="PreviewMascotImage"
                                    SourcePath="Assets/cerneala-mascot-void-suction-well.svg"
                                    Width="205"
                                    Height="205"
                                    UseIntrinsicSize="False"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="CERNEALA / MASCOT"
                                    FontFamily="Cascadia Mono SemiBold"
                                    FontSize="9"
                                    Foreground="$CyanBrush"
                                    Margin="12"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                        <Border
                            Name="PreviewTypography"
                            Visibility="Collapsed"
                            Background="#FFF1F2ED"
                            BorderBrush="$PinkBrush"
                            BorderThickness="8,0,0,0"
                            Padding="24">
                            <StackPanel
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="PRISM"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="58"
                                    Foreground="#FF111318" />
                                <Border
                                    Height="7"
                                    Background="$CyanBrush"
                                    Margin="0,2,40,12" />
                                <TextBlock
                                    Text="COLOR / LIGHT / COMPOSITE"
                                    FontFamily="Cascadia Mono SemiBold"
                                    FontSize="9"
                                    Foreground="#FF343A46" />
                            </StackPanel>
                        </Border>
                        <Border
                            Name="PreviewBadge"
                            Visibility="Collapsed"
                            Background="#FF11151B"
                            BorderBrush="$OrangeBrush"
                            BorderThickness="1"
                            Padding="30">
                            <Grid>
                                <Border
                                    Width="180"
                                    Height="180"
                                    Background="$PinkWashBrush"
                                    BorderBrush="$PinkBrush"
                                    BorderThickness="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Border
                                    Width="118"
                                    Height="118"
                                    Background="$CyanWashBrush"
                                    BorderBrush="$CyanBrush"
                                    BorderThickness="7"
                                    Rotation="45"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="P"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="52"
                                    Foreground="$PaperBrush"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border
                            Name="PreviewCard"
                            Visibility="Collapsed"
                            Background="#FFEFF2F3"
                            BorderBrush="$LimeBrush"
                            BorderThickness="1"
                            Padding="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Text="SURFACE 04"
                                    FontFamily="Cascadia Mono SemiBold"
                                    FontSize="9"
                                    Foreground="#FF39414A" />
                                <StackPanel
                                    Grid.Row="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="Ready to render"
                                        FontFamily="Bahnschrift SemiBold"
                                        FontSize="28"
                                        Foreground="#FF101419" />
                                    <TextBlock
                                        Text="Four targets. One non-destructive Prism stack."
                                        FontSize="12"
                                        Foreground="#FF56616B"
                                        TextWrapping="Wrap"
                                        Margin="0,8,0,0" />
                                </StackPanel>
                                <Border
                                    Grid.Row="2"
                                    Height="34"
                                    Background="#FF101419"
                                    Padding="12,8,12,8">
                                    <TextBlock
                                        Text="COMMIT FRAME"
                                        FontFamily="Cascadia Mono SemiBold"
                                        FontSize="9"
                                        Foreground="$LimeBrush" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Aspect="$PrismStudioGhostButton" Content="MASCOT" Click="OnTargetMascot" Padding="5" Margin="0,0,3,0" />
                    <Button Aspect="$PrismStudioGhostButton" Grid.Column="1" Content="TYPE" Click="OnTargetTypography" Padding="5" Margin="3,0,3,0" />
                    <Button Aspect="$PrismStudioGhostButton" Grid.Column="2" Content="BADGE" Click="OnTargetBadge" Padding="5" Margin="3,0,3,0" />
                    <Button Aspect="$PrismStudioGhostButton" Grid.Column="3" Content="UI CARD" Click="OnTargetCard" Padding="5" Margin="3,0,0,0" />
                </Grid>
            </Grid>
            <Grid
                Grid.Column="1"
                Margin="10,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        Text="LAYERS"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="9"
                        Foreground="$LimeBrush"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Name="LayerCountText"
                        Text="02"
                        FontFamily="Cascadia Mono"
                        FontSize="9"
                        Foreground="$SlateDimBrush"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer
                    Name="LayersHost"
                    Grid.Row="1"
                    Background="$PanelAltBrush"
                    BorderBrush="$LineStrongBrush"
                    BorderThickness="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl
                            Name="LayerItems"
                            ItemsSource="$root.LayerRows"
                            Margin="8">
                            <ItemsControl.ItemsPanel>
                                <StackPanel />
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Templates>
                                <ContentTemplate DataType="studio:PrismStudioLayerRow">
                                    <Border
                                        Background="#FF14181E"
                                        Margin="0,0,0,7"
                                        Padding="7">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox
                                                    Aspect="$PrismStudioCheckBox"
                                                    IsChecked="$DataContext.IsVisible:TwoWay" />
                                                <ToggleButton
                                                    Aspect="$PrismStudioSelectionButton"
                                                    Content="$DataContext.Content"
                                                    IsChecked="$DataContext.IsSelected"
                                                    Command="$DataContext.SelectCommand"
                                                    Width="100" />
                                                <Button
                                                    Aspect="$PrismStudioButton"
                                                    Content="^"
                                                    Command="$DataContext.MoveUpCommand"
                                                    Padding="4" />
                                                <Button
                                                    Aspect="$PrismStudioButton"
                                                    Content="v"
                                                    Command="$DataContext.MoveDownCommand"
                                                    Padding="4" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="FILTERS"
                                                FontFamily="Cascadia Mono SemiBold"
                                                FontSize="8"
                                                Foreground="$SlateBrush"
                                                Margin="0,6,0,4" />
                                            <ItemsControl ItemsSource="$DataContext.Filters">
                                                <ItemsControl.ItemsPanel>
                                                    <StackPanel />
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.Templates>
                                                    <ContentTemplate DataType="studio:PrismStudioOperationRow">
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox
                                                                Aspect="$PrismStudioCheckBox"
                                                                IsChecked="$DataContext.IsVisible:TwoWay" />
                                                            <ToggleButton
                                                                Aspect="$PrismStudioSelectionButton"
                                                                Content="$DataContext.Content"
                                                                IsChecked="$DataContext.IsSelected"
                                                                Command="$DataContext.SelectCommand"
                                                                Width="100" />
                                                            <Button Aspect="$PrismStudioButton" Content="^" Command="$DataContext.MoveUpCommand" Padding="4" />
                                                            <Button Aspect="$PrismStudioButton" Content="v" Command="$DataContext.MoveDownCommand" Padding="4" />
                                                        </StackPanel>
                                                    </ContentTemplate>
                                                </ItemsControl.Templates>
                                            </ItemsControl>
                                            <TextBlock
                                                Text="STYLES"
                                                FontFamily="Cascadia Mono SemiBold"
                                                FontSize="8"
                                                Foreground="$SlateBrush"
                                                Margin="0,6,0,4" />
                                            <ItemsControl ItemsSource="$DataContext.Styles">
                                                <ItemsControl.ItemsPanel>
                                                    <StackPanel />
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.Templates>
                                                    <ContentTemplate DataType="studio:PrismStudioOperationRow">
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox
                                                                Aspect="$PrismStudioCheckBox"
                                                                IsChecked="$DataContext.IsVisible:TwoWay" />
                                                            <ToggleButton
                                                                Aspect="$PrismStudioSelectionButton"
                                                                Content="$DataContext.Content"
                                                                IsChecked="$DataContext.IsSelected"
                                                                Command="$DataContext.SelectCommand"
                                                                Width="100" />
                                                            <Button Aspect="$PrismStudioButton" Content="^" Command="$DataContext.MoveUpCommand" Padding="4" />
                                                            <Button Aspect="$PrismStudioButton" Content="v" Command="$DataContext.MoveDownCommand" Padding="4" />
                                                        </StackPanel>
                                                    </ContentTemplate>
                                                </ItemsControl.Templates>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </ContentTemplate>
                            </ItemsControl.Templates>
                        </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Aspect="$PrismStudioPrimaryButton" Content="+ LAYER" Click="OnAddLayer" Padding="7" Margin="0,0,4,0" />
                    <Button Aspect="$PrismStudioGhostButton" Grid.Column="1" Content="DELETE" Click="OnDeleteLayer" Padding="7" Margin="4,0,0,0" />
                </Grid>
            </Grid>
            <Grid
                Grid.Column="2"
                Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="0.86*" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="1.14*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        Text="CATALOG"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="9"
                        Foreground="$OrangeBrush"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Name="CatalogCountText"
                        Text="000 / 144"
                        FontFamily="Cascadia Mono"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        Name="SearchBox"
                        TextChanged="OnCatalogSearchChanged"
                        Background="$PanelAltBrush"
                        Foreground="$PaperBrush"
                        CaretBrush="#FFFFFFFF"
                        BorderBrush="$LineStrongBrush"
                        BorderThickness="1"
                        Padding="9,7,9,7"
                        FontFamily="Cascadia Mono"
                        FontSize="10" />
                    <Grid Grid.Row="1" Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Name="FilterTab" Aspect="$PrismStudioSelectionButton" Content="FILTERS" Click="OnFiltersTab" Margin="0,0,3,0" />
                        <ToggleButton Name="StyleTab" Aspect="$PrismStudioSelectionButton" Grid.Column="1" Content="STYLES" Click="OnStylesTab" Margin="3,0,3,0" />
                        <Button Name="CategoryButton" Aspect="$PrismStudioCatalogButton" Grid.Column="2" Content="ALL CATEGORIES" Click="OnCategory" Margin="3,0,0,0" />
                    </Grid>
                    <ScrollViewer
                        Name="CatalogHost"
                        Grid.Row="2"
                        Background="$PanelAltBrush"
                        BorderBrush="$LineStrongBrush"
                        BorderThickness="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl
                            Name="CatalogItems"
                            ItemsSource="$root.CatalogRows"
                            Margin="8">
                            <ItemsControl.ItemsPanel>
                                <VirtualizingStackPanel />
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Templates>
                                <ContentTemplate DataType="studio:PrismStudioCatalogRow">
                                    <Button
                                        Aspect="$PrismStudioButton"
                                        Content="$DataContext.Content"
                                        Command="$DataContext.Command"
                                        Margin="0,0,0,4" />
                                </ContentTemplate>
                            </ItemsControl.Templates>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <Grid Grid.Row="2">
                    <TextBlock
                        Text="INSPECTOR"
                        FontFamily="Cascadia Mono SemiBold"
                        FontSize="9"
                        Foreground="$PinkBrush"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Name="InspectorSelectionText"
                        Text="LAYER"
                        FontFamily="Cascadia Mono"
                        FontSize="8"
                        Foreground="$SlateDimBrush"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer
                    Name="InspectorHost"
                    Grid.Row="3"
                    Background="$PanelAltBrush"
                    BorderBrush="$LineStrongBrush"
                    BorderThickness="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl
                        Name="InspectorItems"
                        ItemsSource="$root.InspectorRows"
                        Margin="8">
                        <ItemsControl.ItemsPanel>
                            <StackPanel />
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Templates>
                            <ContentTemplate DataType="studio:PrismStudioLayerTitleRow">
                                <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$LimeBrush" Margin="0,6,0,4" TextWrapping="Wrap" />
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioOperationTitleRow">
                                <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$PinkBrush" Margin="0,6,0,4" TextWrapping="Wrap" />
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioUnitSliderRow">
                                <StackPanel Margin="0,5,0,7">
                                    <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$SlateBrush" Margin="0,0,0,4" />
                                    <Slider Aspect="$PrismStudioSlider" Minimum="0" Maximum="1" Value="$DataContext.Value:TwoWay" />
                                </StackPanel>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioChoiceRow">
                                <StackPanel Margin="0,5,0,7">
                                    <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$SlateBrush" Margin="0,0,0,4" />
                                    <ComboBox Aspect="$PrismStudioComboBox" ItemsSource="$DataContext.Items" SelectedIndex="$DataContext.SelectedIndex:TwoWay" />
                                </StackPanel>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioBooleanRow">
                                <StackPanel Margin="0,5,0,7">
                                    <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$SlateBrush" Margin="0,0,0,4" />
                                    <CheckBox Aspect="$PrismStudioCheckBox" IsChecked="$DataContext.IsChecked:TwoWay" />
                                </StackPanel>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioFiniteNumberRow">
                                <StackPanel Margin="0,5,0,7">
                                    <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$SlateBrush" Margin="0,0,0,4" />
                                    <Slider Aspect="$PrismStudioSlider" Minimum="$DataContext.Minimum" Maximum="$DataContext.Maximum" Value="$DataContext.Value:TwoWay" />
                                    <TextBox Aspect="$PrismStudioTextBox" Text="$DataContext.Text:TwoWay" />
                                </StackPanel>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioStepperRow">
                                <StackPanel Margin="0,5,0,7">
                                    <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$SlateBrush" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Aspect="$PrismStudioButton" Content="-" Command="$DataContext.DecreaseCommand" Padding="4" />
                                        <TextBox Aspect="$PrismStudioTextBox" Text="$DataContext.Text:TwoWay" Width="98" />
                                        <Button Aspect="$PrismStudioButton" Content="+" Command="$DataContext.IncreaseCommand" Padding="4" />
                                    </StackPanel>
                                </StackPanel>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioColorRow">
                                <StackPanel Margin="0,5,0,7">
                                    <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$SlateBrush" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <ColorSwatch Width="24" Height="24" BorderBrush="$LineStrongBrush" BorderThickness="1" Margin="0,0,5,0" SelectedColor="$DataContext.SelectedColor:TwoWay" />
                                        <TextBox Aspect="$PrismStudioTextBox" Text="$DataContext.Text:TwoWay" Width="112" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Aspect="$PrismStudioButton" Content="." Background="#FF4DF0FF" Command="$DataContext.SetColorCommand" CommandParameter="#FF4DF0FF" Padding="6,4,6,4" />
                                        <Button Aspect="$PrismStudioButton" Content="." Background="#FFFF3EA5" Command="$DataContext.SetColorCommand" CommandParameter="#FFFF3EA5" Padding="6,4,6,4" />
                                        <Button Aspect="$PrismStudioButton" Content="." Background="#FFC6FF3D" Command="$DataContext.SetColorCommand" CommandParameter="#FFC6FF3D" Padding="6,4,6,4" />
                                        <Button Aspect="$PrismStudioButton" Content="." Background="#FFFF8A3D" Command="$DataContext.SetColorCommand" CommandParameter="#FFFF8A3D" Padding="6,4,6,4" />
                                        <Button Aspect="$PrismStudioButton" Content="." Background="#FFFFFFFF" Command="$DataContext.SetColorCommand" CommandParameter="#FFFFFFFF" Padding="6,4,6,4" />
                                        <Button Aspect="$PrismStudioButton" Content="." Background="#FF000000" Command="$DataContext.SetColorCommand" CommandParameter="#FF000000" Padding="6,4,6,4" />
                                    </StackPanel>
                                </StackPanel>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioVectorRow">
                                <StackPanel Margin="0,5,0,7">
                                    <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$SlateBrush" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="$DataContext.Components">
                                        <ItemsControl.ItemsPanel>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.Templates>
                                            <ContentTemplate DataType="studio:PrismStudioVectorComponentRow">
                                                <TextBox Aspect="$PrismStudioTextBox" Text="$DataContext.Text:TwoWay" Width="54" Margin="0,0,3,0" />
                                            </ContentTemplate>
                                        </ItemsControl.Templates>
                                    </ItemsControl>
                                </StackPanel>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioResourceRow">
                                <StackPanel Margin="0,5,0,7">
                                    <TextBlock Text="$DataContext.Label" FontFamily="Cascadia Mono SemiBold" FontSize="8" Foreground="$SlateBrush" Margin="0,0,0,4" />
                                    <TextBlock Text="RESOURCE REQUIRED / IMPORT DISABLED" FontFamily="Cascadia Mono" FontSize="9" Foreground="$PinkBrush" />
                                </StackPanel>
                            </ContentTemplate>
                            <ContentTemplate DataType="studio:PrismStudioOperationActionsRow">
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,7">
                                    <Button Aspect="$PrismStudioButton" Content="^" Command="$DataContext.MoveUpCommand" Padding="4" />
                                    <Button Aspect="$PrismStudioButton" Content="v" Command="$DataContext.MoveDownCommand" Padding="4" />
                                    <Button Aspect="$PrismStudioButton" Content="DELETE OP" Command="$DataContext.DeleteCommand" />
                                </StackPanel>
                            </ContentTemplate>
                        </ItemsControl.Templates>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border
            Grid.Row="2"
            BorderBrush="$LineBrush"
            BorderThickness="0,1,0,0"
            Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="StatusLayers" Text="LAYERS 02" FontFamily="Cascadia Mono" FontSize="8" Foreground="$SlateBrush" Margin="0,0,18,0" />
                <TextBlock Name="StatusOperations" Grid.Column="1" Text="OPS 04" FontFamily="Cascadia Mono" FontSize="8" Foreground="$SlateBrush" Margin="0,0,18,0" />
                <TextBlock Name="StatusPasses" Grid.Column="2" Text="PASSES 00" FontFamily="Cascadia Mono" FontSize="8" Foreground="$CyanBrush" Margin="0,0,18,0" />
                <TextBlock Name="StatusSurfaces" Grid.Column="3" Text="SURFACES 00 / 0 B" FontFamily="Cascadia Mono" FontSize="8" Foreground="$OrangeBrush" Margin="0,0,18,0" />
                <TextBlock Name="StatusFallback" Grid.Column="4" Text="FALLBACK NONE" FontFamily="Cascadia Mono" FontSize="8" Foreground="$LimeBrush" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

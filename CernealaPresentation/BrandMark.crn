<UserControl>
    <StackPanel
        Orientation="Horizontal"
        VerticalAlignment="Center">
        <SvgImage
            SourcePath="Assets/cerneala-mascot-void-suction-well.svg"
            Width="32"
            Height="32"
            UseIntrinsicSize="False"
            Margin="0,0,10,0" />
        <TextBlock
            Text="CERNEALA"
            FontFamily="Bahnschrift SemiBold"
            FontSize="18"
            Foreground="#FFEDEFF3"
            VerticalAlignment="Center" />
        <TextBlock
            Text=" UI"
            FontFamily="Cascadia Mono SemiBold"
            FontSize="12"
            Foreground="#FF4DF0FF"
            VerticalAlignment="Center"
            Margin="5,1,0,0" />
    </StackPanel>
</UserControl>

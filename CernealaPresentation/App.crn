<Application
    StartupWindow="PresentationWindow"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush
            Name="InkBrush"
            Color="#FF0A0B0E" />
        <SolidColorBrush
            Name="PanelBrush"
            Color="#FF14161B" />
        <SolidColorBrush
            Name="PanelAltBrush"
            Color="#FF101217" />
        <SolidColorBrush
            Name="RaisedBrush"
            Color="#FF191C22" />
        <SolidColorBrush
            Name="LineBrush"
            Color="#FF2A2E38" />
        <SolidColorBrush
            Name="LineStrongBrush"
            Color="#FF424754" />
        <SolidColorBrush
            Name="PaperBrush"
            Color="#FFEDEFF3" />
        <SolidColorBrush
            Name="SlateBrush"
            Color="#FF8A93A6" />
        <SolidColorBrush
            Name="SlateDimBrush"
            Color="#FF565E6E" />
        <SolidColorBrush
            Name="CyanBrush"
            Color="#FF4DF0FF" />
        <SolidColorBrush
            Name="CyanWashBrush"
            Color="#FF10282D" />
        <SolidColorBrush
            Name="PinkBrush"
            Color="#FFFF3EA5" />
        <SolidColorBrush
            Name="PinkWashBrush"
            Color="#FF2C1323" />
        <SolidColorBrush
            Name="LimeBrush"
            Color="#FFC6FF3D" />
        <SolidColorBrush
            Name="LimeWashBrush"
            Color="#FF202914" />
        <SolidColorBrush
            Name="OrangeBrush"
            Color="#FFFF8A3D" />
        <SolidColorBrush
            Name="OrangeWashBrush"
            Color="#FF2C1D14" />
        <SolidColorBrush
            Name="TransparentBrush"
            Color="#00000000" />
        <Aspect
            Name="PresentationScrollThumb"
            TargetType="Thumb">
            @default
            {
                Background = $SlateDimBrush;
                BorderBrush = $LineStrongBrush;
                BorderThickness = "1";
            }
            @when IsMouseOver
            {
                Background = $CyanBrush;
                BorderBrush = $CyanBrush;
            }
        </Aspect>
        <Aspect
            Name="PresentationScrollTrack"
            TargetType="Track">
            @default
            {
                Background = $PanelAltBrush;
                BorderBrush = $LineBrush;
                BorderThickness = "1";
            }
            @template
            {
                <Border
                    Background="$owner.Background"
                    BorderBrush="$owner.BorderBrush"
                    BorderThickness="$owner.BorderThickness"
                    Padding="2">
                    <TrackLayoutPanel
                        Orientation="$owner.Orientation">
                        <Thumb
                            Name="PART_Thumb"
                            Aspect="$PresentationScrollThumb" />
                    </TrackLayoutPanel>
                </Border>
            }
        </Aspect>
        <Aspect
            Name="PresentationScrollBar"
            TargetType="ScrollBar">
            @template
            {
                <Track
                    Name="PART_Track"
                    Aspect="$PresentationScrollTrack" />
            }
        </Aspect>
        <Aspect
            TargetType="ScrollViewer">
            @template
            {
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollContentPresenter
                        Name="PART_ScrollContentPresenter"
                        Grid.Row="0"
                        Grid.Column="0" />
                    <ScrollBar
                        Name="PART_VerticalScrollBar"
                        Aspect="$PresentationScrollBar"
                        Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Vertical"
                        Width="12"
                        Margin="3,0,0,0"
                        Visibility="Collapsed" />
                    <ScrollBar
                        Name="PART_HorizontalScrollBar"
                        Aspect="$PresentationScrollBar"
                        Grid.Row="1"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Height="12"
                        Margin="0,3,0,0"
                        Visibility="Collapsed" />
                </Grid>
            }
        </Aspect>
        <Aspect
            Name="PageReveal"
            TargetType="UserControl">
            @when Visibility
            {
                @if Visibility == Visible
                {
                    @parallel
                    {
                        @animate with Tween(360ms, EaseOut)
                        {
                            @from
                            {
                                Opacity = 0.25;
                            }
                            @to
                            {
                                Opacity = 1;
                            }
                        }
                        @animate with Spring(460, 38)
                        {
                            @from
                            {
                                TranslateY = 18;
                            }
                            @to
                            {
                                TranslateY = 0;
                            }
                        }
                    }
                }
            }
        </Aspect>
        <Aspect
            TargetType="TextBlock">
            @default
            {
                FontFamily = "Segoe UI Variable Text";
                FontSize = 14;
                Foreground = $PaperBrush;
            }
        </Aspect>
        <Aspect
            TargetType="CheckBox">
            @default
            {
                Foreground = $PaperBrush;
                Padding = "0";
            }
            @template
            {
                <Border Padding="$owner.Padding">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Name="PART_Indicator"
                            Width="16"
                            Height="16"
                            Background="$PanelAltBrush"
                            BorderBrush="$LineStrongBrush"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <Border
                                Name="PART_CheckMark"
                                Background="$CyanBrush"
                                Padding="2">
                                <SvgPath
                                    Width="10"
                                    Height="10"
                                    Data="M4.63 15.638a1.028 1.028 0 0 1-.79-.37L.36 11.09a1.03 1.03 0 1 1 1.58-1.316l2.535 3.043L9.958 3.32a1.029 1.029 0 0 1 1.783 1.03L5.52 15.122a1.03 1.03 0 0 1-.803.511.89.89 0 0 1-.088.004z"
                                    ViewBox="-3.5 0 19 19"
                                    Fill="#FF000000"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ContentPresenter
                            Content="$owner.Content"
                            FontFamily="$owner.FontFamily"
                            FontSize="$owner.FontSize"
                            Foreground="$owner.Foreground"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            }
        </Aspect>
        <Aspect
            Name="GhostButton"
            TargetType="Button">
            @default
            {
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 12;
                Background = $TransparentBrush;
                Foreground = $PaperBrush;
                BorderBrush = $LineStrongBrush;
                BorderThickness = "1";
                Padding = "18,11,18,11";
            }
            @when IsMouseOver
            {
                Background = $CyanWashBrush;
                Foreground = $CyanBrush;
                BorderBrush = $CyanBrush;
            }
        </Aspect>
        <Aspect
            Name="LimeButton"
            TargetType="Button">
            @default
            {
                FontFamily = "Cascadia Mono SemiBold";
                FontSize = 12;
                Background = $LimeBrush;
                Foreground = $InkBrush;
                BorderBrush = $LimeBrush;
                BorderThickness = "1";
                Padding = "20,12,20,12";
            }
            @when IsMouseOver
            {
                Background = $CyanBrush;
                BorderBrush = $CyanBrush;
            }
        </Aspect>
    </Application.Resources>
</Application>

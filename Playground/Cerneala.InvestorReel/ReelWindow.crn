<!--
    ReelWindow is the shell. It opens on the theme picker; choosing a theme swaps in a fresh
    instance of that theme's reel, and the last chapter of every reel offers the way back.

    Every screen is composed on a fixed 1600x900 page, scaled to fit the 1280x720 window.
    Navigation is the only thing the code-behind does.
-->
<Window
    xmlns:reel="clr-namespace:Cerneala.InvestorReel"
    Title="Cerneala"
    Width="1280"
    Height="720"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    SourceInitialized="OnSourceInitialized"
    ContentRendered="OnContentRendered"
    Background="$ShellBrush"
    Padding="0">
    <Canvas>
    <Grid
        Name="Page"
        Width="1600"
        Height="900"
        Scale="0.8"
        RenderTransformOrigin="0,0"
        ClipToBounds="True">
        <ContentControl Name="ReelHost" />
        <reel:ThemePicker Name="Picker" />
    </Grid>
    </Canvas>
</Window>

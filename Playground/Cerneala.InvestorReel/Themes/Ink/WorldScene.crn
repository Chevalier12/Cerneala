<!-- viii · worlds beside widgets: a tile map lays itself down, a sprite walks it, colliders show through. -->
<UserControl
    xmlns:reel="clr-namespace:Cerneala.InvestorReel"
    Aspect="$SceneMotion">
    <UserControl.Resources>
        <Tween Name="Lay" Duration="420ms" Easing="EaseOut" />
        <Tween Name="Mark" Duration="520ms" Easing="EaseOut" />
        <Aspect Name="Tile" TargetType="Border">
            @default { Width = 48; Height = 48; Background = $PaperDeepBrush; BorderBrush = $PaperBrush; BorderThickness = "1"; }
        </Aspect>
        <Aspect Name="Grass" TargetType="Border">
            @default { Width = 48; Height = 48; Background = $OchreWashBrush; BorderBrush = $PaperBrush; BorderThickness = "1"; }
        </Aspect>
        <Aspect Name="Water" TargetType="Border">
            @default { Width = 48; Height = 48; Background = $IndigoWashBrush; BorderBrush = $PaperBrush; BorderThickness = "1"; }
        </Aspect>
        <Aspect Name="Stone" TargetType="Border">
            @default { Width = 48; Height = 48; Background = $PaperShadeBrush; BorderBrush = $PaperBrush; BorderThickness = "1"; }
        </Aspect>
        <Aspect Name="Row" TargetType="StackPanel">
            @default { Orientation = "Horizontal"; Opacity = 0; }
        </Aspect>
        <Aspect Name="Part" TargetType="StackPanel">
            @default { Orientation = "Horizontal"; Margin = "0,0,0,16"; Opacity = 0; }
        </Aspect>
        <Aspect Name="PartName" TargetType="TextBlock">
            @default { FontFamily = "Consolas"; FontSize = 18; Foreground = $InkBrush; Width = 190; VerticalAlignment = "Center"; }
        </Aspect>
        <Aspect Name="PartText" TargetType="TextBlock">
            @default { FontFamily = "Sitka Text"; FontSize = 18; Foreground = $InkSoftBrush; VerticalAlignment = "Center"; }
        </Aspect>
        <MotionClip Name="Entrance" TargetType="reel:WorldScene">
            @sequence
            {
                @parallel
                {
                    @animate with Tween(700ms, EaseOut) { @from { $Kicker.Opacity = 0; $Kicker.TranslateX = -18; } @to { $Kicker.Opacity = 1; $Kicker.TranslateX = 0; } }
                    @animate with Tween(900ms, EaseOut) { @from { $Headline.Opacity = 0; $Headline.TranslateY = 24; } @to { $Headline.Opacity = 1; $Headline.TranslateY = 0; } }
                    @animate with Tween(600ms, EaseOut) { @from { $Frame.Opacity = 0; } @to { $Frame.Opacity = 1; } }
                }

                <!-- The map streams in, row by row. -->
                @stagger target $Map each 110ms
                {
                    @animate with $Lay { @from { Opacity = 0; TranslateY = -14; } @to { Opacity = 1; TranslateY = 0; } }
                }

                @parallel
                {
                    <!-- Colliders surface over the art. -->
                    @stagger target $Colliders each 180ms
                    {
                        @animate with $Mark { @from { Opacity = 0; Scale = 1.25; } @to { Opacity = 1; Scale = 1; } }
                    }

                    <!-- The sprite drops in and walks the path. -->
                    @sequence
                    {
                        @parallel
                        {
                            @animate with Tween(200ms, Linear) { @from { $Hero.Opacity = 0; } @to { $Hero.Opacity = 1; } }
                            @animate with Spring(220, 12) { @from { $Hero.TranslateY = -90; } @to { $Hero.TranslateY = 0; } }
                        }
                        @keyframes duration 4400ms
                        {
                            @animate 0%..40% with EaseInOut { @from { $Hero.TranslateX = 0; } @to { $Hero.TranslateX = 192; } }
                            @animate 40%..60% with EaseOut { @from { $Hero.TranslateY = 0; } @to { $Hero.TranslateY = -96; } }
                            @animate 60%..100% with EaseInOut { @from { $Hero.TranslateX = 192; } @to { $Hero.TranslateX = 290; } }
                        }

                        <!-- The sprite reaches the coin; the circle collider answers. -->
                        @parallel
                        {
                            @animate with PingPong(Tween(200ms, EaseOut), 2) { @from { $Coin.Scale = 1; } @to { $Coin.Scale = 1.5; } }
                            @animate with Tween(500ms, EaseOut) { @from { $CoinRing.Opacity = 1; $CoinRing.Scale = 1; } @to { $CoinRing.Opacity = 0; $CoinRing.Scale = 2.4; } }
                            @animate with Tween(700ms, EaseOut) { @from { $Hit.Opacity = 0; $Hit.TranslateY = 8; } @to { $Hit.Opacity = 1; $Hit.TranslateY = 0; } }
                        }
                        @animate with Tween(800ms, EaseOut) { @from { $Caption.Opacity = 0; } @to { $Caption.Opacity = 1; } }
                    }

                    <!-- A step bob, on its own element so it never fights the walk. -->
                    @sequence
                    {
                        @animate with Tween(900ms, Linear) { @from { $HeroBody.TranslateY = 0; } @to { $HeroBody.TranslateY = 0; } }
                        @animate with PingPong(Tween(220ms, EaseInOut), forever) { @from { $HeroBody.TranslateY = 0; } @to { $HeroBody.TranslateY = -4; } }
                    }

                    @stagger target $Parts each 200ms
                    {
                        @animate with $Mark { @from { Opacity = 0; TranslateX = 24; } @to { Opacity = 1; TranslateX = 0; } }
                    }
                }
            }
        </MotionClip>
        <Aspect Name="SceneMotion" TargetType="reel:WorldScene">
            @handle Playback;
            @when $self.Visibility
            {
                @if value == Visible
                {
                    @run $Entrance as Playback;
                }
            }
        </Aspect>
    </UserControl.Resources>

    <Grid Margin="170,110,120,110">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="640" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Name="Kicker" Text="worlds beside widgets" Aspect="$Note" Opacity="0" />
            <TextBlock Name="Headline" Text="A game world is just another view." Aspect="$Display" Margin="0,6,0,0" Opacity="0" />
        </StackPanel>

        <!-- Scene2D: a 12 × 6 tile map with a sprite and its colliders. -->
        <Border Name="Frame" Grid.Row="1" Grid.Column="0" Aspect="$Sheet" Padding="16" Width="610" Height="334" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,34,0,0" Opacity="0">
            <Grid Width="576" Height="288">
                <StackPanel Name="Map">
                    <StackPanel Aspect="$Row">
                        <Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" />
                        <Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Water" /><Border Aspect="$Water" /><Border Aspect="$Water" />
                    </StackPanel>
                    <StackPanel Aspect="$Row">
                        <Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" />
                        <Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Water" /><Border Aspect="$Water" />
                    </StackPanel>
                    <StackPanel Aspect="$Row">
                        <Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Grass" /><Border Aspect="$Grass" />
                        <Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Water" />
                    </StackPanel>
                    <StackPanel Aspect="$Row">
                        <Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Stone" /><Border Aspect="$Stone" />
                        <Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" /><Border Aspect="$Tile" />
                    </StackPanel>
                    <StackPanel Aspect="$Row">
                        <Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Grass" />
                        <Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Grass" /><Border Aspect="$Grass" />
                    </StackPanel>
                    <StackPanel Aspect="$Row">
                        <Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Stone" />
                        <Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Stone" /><Border Aspect="$Stone" />
                    </StackPanel>
                </StackPanel>

                <!-- Collider outlines: the ledge and the ground are boxes, the coin is a circle. -->
                <Grid Name="Colliders">
                    <Grid Width="192" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="192,144,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border Width="192" Height="48" BorderBrush="$VermilionBrush" BorderThickness="2" />
                        <TextBlock Text="BoxCollider2D" Aspect="$Caps" FontSize="11" Foreground="$VermilionBrush" Margin="8,17,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Width="576" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,240,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border Width="576" Height="48" BorderBrush="$VermilionBrush" BorderThickness="2" />
                    </Grid>
                    <Grid Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="330,98,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Width="56" Height="56" Stroke="$VermilionBrush" StrokeThickness="2" />
                        <TextBlock Text="CircleCollider2D" Aspect="$Caps" FontSize="11" Foreground="$VermilionBrush" Margin="-40,-20,0,0" VerticalAlignment="Top" />
                    </Grid>
                </Grid>

                <!-- The coin. -->
                <Ellipse Name="CoinRing" Width="28" Height="28" Stroke="$OchreBrush" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="344,112,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5" />
                <Ellipse Name="Coin" Width="28" Height="28" Fill="$OchreBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="344,112,0,0" RenderTransformOrigin="0.5,0.5" />

                <!-- The sprite: stands on the ground row, walks right, hops onto the ledge and runs into the coin. -->
                <Grid Name="Hero" Width="32" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,196,0,0" Opacity="0">
                    <Grid Name="HeroBody">
                        <Ellipse Width="18" Height="18" Fill="$InkBrush" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <Border Width="22" Height="22" Background="$InkBrush" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />
                        <Border Width="6" Height="6" Background="$VermilionBrush" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="6,6,0,0" />
                    </Grid>
                </Grid>

                <TextBlock Name="Hit" Text="contact!" Aspect="$Note" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="400,104,0,0" Opacity="0" />
            </Grid>
        </Border>

        <!-- What ships in the box. -->
        <StackPanel Name="Parts" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="56,44,0,0">
            <StackPanel Aspect="$Part">
                <TextBlock Text="Scene2D" Aspect="$PartName" />
                <TextBlock Text="a camera, layers and a world, in markup" Aspect="$PartText" />
            </StackPanel>
            <StackPanel Aspect="$Part">
                <TextBlock Text="Sprite2D" Aspect="$PartName" />
                <TextBlock Text="sprites with frame animations" Aspect="$PartText" />
            </StackPanel>
            <StackPanel Aspect="$Part">
                <TextBlock Text="TileMap2D" Aspect="$PartName" />
                <TextBlock Text="streamed, cached, with tile collision" Aspect="$PartText" />
            </StackPanel>
            <StackPanel Aspect="$Part">
                <TextBlock Text="Colliders" Aspect="$PartName" />
                <TextBlock Text="box, circle, polygon, segment" Aspect="$PartText" />
            </StackPanel>
            <StackPanel Aspect="$Part">
                <TextBlock Text="Importers" Aspect="$PartName" />
                <TextBlock Text="Tiled and LDtk maps come straight in" Aspect="$PartText" />
            </StackPanel>
            <StackPanel Aspect="$Part">
                <TextBlock Text="Packages" Aspect="$PartName" />
                <TextBlock Text="chunked scenes, loaded as you move" Aspect="$PartText" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Name="Caption"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Text="Maps, sprites and physics live in the same tree as your buttons. Same renderer, same tools, no second engine."
            Aspect="$Lede"
            Opacity="0" />
    </Grid>
</UserControl>

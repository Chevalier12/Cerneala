<!-- 06 · REDRAW: a raw spreadsheet moves to the next frame; one cell is struck out and rewritten, twenty-three are kept. -->
<UserControl
    xmlns:reel="clr-namespace:Cerneala.InvestorReel"
    Aspect="$SceneMotion">
    <UserControl.Resources>
        <Tween Name="Slam" Duration="150ms" Easing="EaseIn" />
        <Tween Name="Cut" Duration="60ms" Easing="Linear" />
        <Aspect Name="SheetRow" TargetType="Grid">
            @default { Height = 48; Opacity = 0; }
        </Aspect>
        <Aspect Name="Cell" TargetType="TextBlock">
            @default { FontFamily = "Courier New"; FontSize = 22; Foreground = $BrBlackBrush; VerticalAlignment = "Center"; Margin = "14,0,0,0"; }
        </Aspect>
        <Aspect Name="Money" TargetType="TextBlock">
            @default { FontFamily = "Courier New"; FontSize = 22; Foreground = $BrBlackBrush; VerticalAlignment = "Center"; HorizontalAlignment = "Right"; Margin = "0,0,14,0"; }
        </Aspect>
        <Aspect Name="Head" TargetType="TextBlock">
            @default { FontFamily = "Impact"; FontSize = 20; Foreground = $BrWhiteBrush; VerticalAlignment = "Center"; Margin = "14,0,0,0"; }
        </Aspect>
        <Aspect Name="RowLine" TargetType="Border">
            @default { Height = 2; Background = $BrBlackBrush; VerticalAlignment = "Bottom"; }
        </Aspect>
        <MotionClip Name="Entrance" TargetType="reel:BrutalRedrawScene">
            @sequence
            {
                @parallel
                {
                    @animate with $Cut { @from { $Tape.Opacity = 0; } @to { $Tape.Opacity = 1; } }
                    @animate with $Cut { @from { $Headline.Opacity = 0; } @to { $Headline.Opacity = 1; } }
                    @animate with $Slam { @from { $Headline.TranslateX = -90; } @to { $Headline.TranslateX = 0; } }
                    @animate with $Cut { @from { $Sheet.Opacity = 0; } @to { $Sheet.Opacity = 1; } }
                }
                @stagger target $Rows each 100ms
                {
                    @animate with $Cut { @from { Opacity = 0; } @to { Opacity = 1; } }
                }
                @animate with $Cut { @from { $FrameN.Opacity = 0; $OldValue.Opacity = 0; } @to { $FrameN.Opacity = 1; $OldValue.Opacity = 1; } }
                @animate with Tween(700ms, Linear) { @from { $FrameN.Opacity = 1; } @to { $FrameN.Opacity = 1; } }

                <!-- Frame N + 1 -->
                @parallel
                {
                    @animate with $Cut { @from { $FrameN.Opacity = 1; $FrameNext.Opacity = 0; } @to { $FrameN.Opacity = 0; $FrameNext.Opacity = 1; } }
                    @animate with $Cut { @from { $Rows.Opacity = 1; } @to { $Rows.Opacity = 0.25; } }
                    @animate with $Cut { @from { $Hit.Opacity = 0; } @to { $Hit.Opacity = 1; } }
                }
                @animate with Tween(140ms, Linear) { @from { $Strike.ScaleX = 0; } @to { $Strike.ScaleX = 1; } }
                @animate with Tween(300ms, Linear) { @from { $Strike.Opacity = 1; } @to { $Strike.Opacity = 1; } }
                @parallel
                {
                    @animate with $Cut { @from { $OldValue.Opacity = 1; $Strike.Opacity = 1; $NewValue.Opacity = 0; } @to { $OldValue.Opacity = 0; $Strike.Opacity = 0; $NewValue.Opacity = 1; } }
                }
                @stagger target $Verdict each 220ms
                {
                    @animate with $Slam { @from { Opacity = 1; TranslateY = -50; } @to { Opacity = 1; TranslateY = 0; } }
                }
                @animate with $Cut { @from { $Caption.Opacity = 0; } @to { $Caption.Opacity = 1; } }
            }
        </MotionClip>
        <Aspect Name="SceneMotion" TargetType="reel:BrutalRedrawScene">
            @handle Playback;
            @when $self.Visibility
            {
                @if value == Visible
                {
                    @run $Entrance as Playback;
                }
            }
        </Aspect>
    </UserControl.Resources>

    <Grid Margin="160,124,140,110">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border Name="Tape" Background="$BrBlackBrush" Padding="12,4,12,5" HorizontalAlignment="Left" Opacity="0">
                <TextBlock Text="[06] RETAINED TREE / FRAME N TO FRAME N+1" FontFamily="Courier New" FontSize="16" Foreground="$BrWhiteBrush" />
            </Border>
            <TextBlock Name="Headline" Text="ONLY WHAT CHANGES IS REDRAWN." Aspect="$BrDisplay" FontSize="88" Margin="0,4,0,0" Opacity="0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid Name="Sheet" Width="852" Height="352" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0">
                <Border Background="$BrBlackBrush" Margin="14,14,-14,-14" />
                <Border Background="$BrWhiteBrush" BorderBrush="$BrBlackBrush" BorderThickness="4" />
                <StackPanel Margin="4">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" /><ColumnDefinition Width="300" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="4" Background="$BrBlackBrush" />
                        <TextBlock Grid.Column="0" Text="ID" Aspect="$Head" />
                        <TextBlock Grid.Column="1" Text="ACCOUNT" Aspect="$Head" />
                        <TextBlock Grid.Column="2" Text="MONTH" Aspect="$Head" />
                        <TextBlock Grid.Column="3" Text="BALANCE / LEI" Aspect="$Head" />
                    </Grid>
                    <StackPanel Name="Rows">
                        <Grid Aspect="$SheetRow"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="300" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="0x01" Aspect="$Cell" /><TextBlock Grid.Column="1" Text="INVOICES" Aspect="$Cell" /><TextBlock Grid.Column="2" Text="MAR" Aspect="$Cell" /><TextBlock Grid.Column="3" Text="8,410.00" Aspect="$Money" /><Border Grid.ColumnSpan="4" Aspect="$RowLine" /></Grid>
                        <Grid Aspect="$SheetRow"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="300" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="0x02" Aspect="$Cell" /><TextBlock Grid.Column="1" Text="CLIENTS" Aspect="$Cell" /><TextBlock Grid.Column="2" Text="MAR" Aspect="$Cell" /><TextBlock Grid.Column="3" Text="3,075.50" Aspect="$Money" /><Border Grid.ColumnSpan="4" Aspect="$RowLine" /></Grid>
                        <Grid Aspect="$SheetRow"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="300" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="0x03" Aspect="$Cell" /><TextBlock Grid.Column="1" Text="LEDGER" Aspect="$Cell" /><TextBlock Grid.Column="2" Text="MAR" Aspect="$Cell" /><Border Grid.ColumnSpan="4" Aspect="$RowLine" /></Grid>
                        <Grid Aspect="$SheetRow"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="300" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="0x04" Aspect="$Cell" /><TextBlock Grid.Column="1" Text="BILLING" Aspect="$Cell" /><TextBlock Grid.Column="2" Text="MAR" Aspect="$Cell" /><TextBlock Grid.Column="3" Text="12,980.25" Aspect="$Money" /><Border Grid.ColumnSpan="4" Aspect="$RowLine" /></Grid>
                        <Grid Aspect="$SheetRow"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="300" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="0x05" Aspect="$Cell" /><TextBlock Grid.Column="1" Text="REPORTS" Aspect="$Cell" /><TextBlock Grid.Column="2" Text="MAR" Aspect="$Cell" /><TextBlock Grid.Column="3" Text="640.00" Aspect="$Money" /><Border Grid.ColumnSpan="4" Aspect="$RowLine" /></Grid>
                        <Grid Aspect="$SheetRow"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="300" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="0x06" Aspect="$Cell" /><TextBlock Grid.Column="1" Text="TASKS" Aspect="$Cell" /><TextBlock Grid.Column="2" Text="MAR" Aspect="$Cell" /><TextBlock Grid.Column="3" Text="2,215.75" Aspect="$Money" /></Grid>
                    </StackPanel>
                </StackPanel>
                <Border Width="2" Background="$BrBlackBrush" HorizontalAlignment="Left" Margin="124,4,0,4" />
                <Border Width="2" Background="$BrBlackBrush" HorizontalAlignment="Left" Margin="424,4,0,4" />
                <Border Width="2" Background="$BrBlackBrush" HorizontalAlignment="Left" Margin="624,4,0,4" />

                <!-- Row three, balance column: the one cell that changes. -->
                <Grid Width="222" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="626,148,0,0">
                    <Border Name="Hit" Background="$BrOrangeBrush" Opacity="0" />
                    <TextBlock Name="OldValue" Text="1,204.00" Aspect="$Money" Opacity="0" />
                    <Border Name="Strike" Width="130" Height="5" Background="$BrBlackBrush" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" ScaleX="0" RenderTransformOrigin="0,0.5" />
                    <TextBlock Name="NewValue" Text="1,268.00" FontFamily="Segoe UI Black" FontSize="22" Foreground="$BrBlackBrush" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0" />
                </Grid>
                <Border Name="FrameN" Background="$BrBlackBrush" Padding="10,3,10,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-50" Opacity="0">
                    <TextBlock Text="FRAME N" FontFamily="Courier New" FontSize="15" Foreground="$BrWhiteBrush" />
                </Border>
                <Border Name="FrameNext" Background="$BrOrangeBrush" Padding="10,3,10,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-50" Opacity="0">
                    <TextBlock Text="FRAME N + 1" FontFamily="Courier New" FontSize="15" Foreground="$BrBlackBrush" />
                </Border>
            </Grid>

            <StackPanel Name="Verdict" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Opacity="0">
                    <TextBlock Text="1" FontFamily="Impact" FontSize="150" Foreground="$BrOrangeBrush" />
                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,0,30"><TextBlock Text="CELL" FontFamily="Impact" FontSize="40" Foreground="$BrBlackBrush" /><TextBlock Text="REDRAWN." FontFamily="Impact" FontSize="40" Foreground="$BrBlackBrush" /></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Opacity="0">
                    <TextBlock Text="23" FontFamily="Impact" FontSize="150" Foreground="$BrBlackBrush" />
                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,0,30"><TextBlock Text="KEPT FROM" FontFamily="Impact" FontSize="40" Foreground="$BrBlackBrush" /><TextBlock Text="LAST FRAME." FontFamily="Impact" FontSize="40" Foreground="$BrBlackBrush" /></StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock
            Name="Caption"
            Grid.Row="2"
            Text="CERNEALA KEEPS A RETAINED TREE BETWEEN FRAMES. A CHANGE REDOES ONLY THE WORK IT REQUIRES; UNCHANGED DRAWING IS REUSED."
            Aspect="$BrLede"
            FontSize="20"
            Opacity="0" />
    </Grid>
</UserControl>

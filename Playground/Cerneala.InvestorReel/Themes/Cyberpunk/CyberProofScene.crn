<!-- 10 · AUTOPILOT: a Servo script locks onto a button and clicks it for real; Detective reads back the frame as telemetry. -->
<UserControl
    xmlns:reel="clr-namespace:Cerneala.InvestorReel"
    Aspect="$SceneMotion">
    <UserControl.Resources>
        <Tween Name="Arrive" Duration="480ms" Easing="EaseOut" />
        <Tween Name="Next" Duration="260ms" Easing="EaseInOut" />
        <Aspect Name="Script" TargetType="TextBlock">
            @default { FontFamily = "Cascadia Mono"; FontSize = 16; Foreground = $CyTextBrush; Height = 30; Opacity = 0; }
        </Aspect>
        <Aspect Name="Field" TargetType="Border">
            @default { Width = 392; Height = 36; Background = $CyNightBrush; BorderBrush = $CyGridBrush; BorderThickness = "1"; Padding = "12,0,12,0"; HorizontalAlignment = "Left"; VerticalAlignment = "Top"; }
        </Aspect>
        <Aspect Name="FieldText" TargetType="TextBlock">
            @default { FontFamily = "Bahnschrift Light"; FontSize = 18; Foreground = $CyTextBrush; VerticalAlignment = "Center"; }
        </Aspect>
        <Aspect Name="Counter" TargetType="Border">
            @default { Width = 150; Background = $CyPanelBrush; BorderBrush = $CyCyanDimBrush; BorderThickness = "1"; Padding = "16,12,12,14"; Margin = "0,0,12,0"; Opacity = 0; }
        </Aspect>
        <Aspect Name="CounterValue" TargetType="TextBlock">
            @default { FontFamily = "Bahnschrift"; FontSize = 42; Foreground = $CyCyanBrush; }
        </Aspect>
        <Aspect Name="CounterName" TargetType="TextBlock">
            @default { FontFamily = "Cascadia Mono"; FontSize = 12; Foreground = $CyDimBrush; Margin = "0,2,0,0"; }
        </Aspect>
        <MotionClip Name="Entrance" TargetType="reel:CyberProofScene">
            @sequence
            {
                @parallel
                {
                    @animate with Tween(300ms, Linear) { @from { $Kicker.Opacity = 0; } @to { $Kicker.Opacity = 1; } }
                    @animate with Tween(160ms, Linear) { @from { $Headline.Opacity = 0; } @to { $Headline.Opacity = 1; } }
                    @animate with PingPong(Tween(45ms, Linear), 6) { @from { $Headline.TranslateX = 0; } @to { $Headline.TranslateX = 12; } }
                    @animate with Tween(700ms, EaseOut) { @from { $App.Opacity = 0; $App.TranslateY = 26; } @to { $App.Opacity = 1; $App.TranslateY = 0; } }
                    @animate with Tween(800ms, EaseOut) { @from { $ScriptSheet.Opacity = 0; $ScriptSheet.TranslateX = 30; } @to { $ScriptSheet.Opacity = 1; $ScriptSheet.TranslateX = 0; } }
                }
                @stagger target $Lines each 100ms
                {
                    @animate with $Arrive { @from { Opacity = 0; TranslateX = -10; } @to { Opacity = 1; TranslateX = 0; } }
                }

                <!-- Line 1: the button gets a stable id, and Servo finds it by that id. -->
                @parallel
                {
                    @animate with $Next { @from { $Marker.Opacity = 0; } @to { $Marker.Opacity = 1; } }
                    @animate with $Arrive { @from { $Target.Opacity = 0; $Target.Scale = 1.15; } @to { $Target.Opacity = 1; $Target.Scale = 1; } }
                    @animate with $Arrive { @from { $TargetId.Opacity = 0; $TargetId.TranslateY = 6; } @to { $TargetId.Opacity = 1; $TargetId.TranslateY = 0; } }
                }
                @animate with Tween(300ms, Linear) { @from { $Marker.TranslateY = 0; } @to { $Marker.TranslateY = 0; } }

                <!-- Line 2: a real click, through the real input pipeline. -->
                @animate with $Next { @from { $Marker.TranslateY = 0; } @to { $Marker.TranslateY = 30; } }
                @parallel
                {
                    @animate with Tween(200ms, Linear) { @from { $Cursor.Opacity = 0; } @to { $Cursor.Opacity = 1; } }
                    @animate with Tween(900ms, EaseInOut) { @from { $Cursor.TranslateX = 300; $Cursor.TranslateY = 120; } @to { $Cursor.TranslateX = 84; $Cursor.TranslateY = 248; } }
                }
                @parallel
                {
                    @animate with PingPong(Tween(110ms, EaseOut), 2) { @from { $SaveButton.Scale = 1; } @to { $SaveButton.Scale = 0.93; } }
                    @animate with Tween(520ms, EaseOut) { @from { $Ripple.Opacity = 0.7; $Ripple.Scale = 0.3; } @to { $Ripple.Opacity = 0; $Ripple.Scale = 2.2; } }
                }
                @parallel
                {
                    @animate with Tween(260ms, EaseOut) { @from { $Unsaved.Opacity = 1; } @to { $Unsaved.Opacity = 0; } }
                    @animate with Tween(260ms, EaseOut) { @from { $Saved.Opacity = 0; $Saved.TranslateY = 6; } @to { $Saved.Opacity = 1; $Saved.TranslateY = 0; } }
                    @animate with Tween(400ms, EaseOut) { @from { $Target.Opacity = 1; } @to { $Target.Opacity = 0; } }
                    @animate with Tween(400ms, EaseOut) { @from { $TargetId.Opacity = 1; } @to { $TargetId.Opacity = 0.5; } }
                }

                <!-- Line 3: wait for the frame to settle, not for a guess. -->
                @animate with $Next { @from { $Marker.TranslateY = 30; } @to { $Marker.TranslateY = 60; } }
                @animate with Tween(400ms, Linear) { @from { $Marker.Opacity = 1; } @to { $Marker.Opacity = 1; } }

                <!-- Line 4: keep the evidence. -->
                @animate with $Next { @from { $Marker.TranslateY = 60; } @to { $Marker.TranslateY = 90; } }
                @animate with Tween(560ms, EaseOut) { @from { $Shutter.Opacity = 0.85; } @to { $Shutter.Opacity = 0; } }

                <!-- Detective reads back the frame the click produced. -->
                @animate with Tween(500ms, EaseOut) { @from { $FrameTitle.Opacity = 0; $FrameTitle.TranslateY = 8; } @to { $FrameTitle.Opacity = 1; $FrameTitle.TranslateY = 0; } }
                @stagger target $Counters each 120ms
                {
                    @animate with $Arrive { @from { Opacity = 0; TranslateY = 14; } @to { Opacity = 1; TranslateY = 0; } }
                }
                @animate with Tween(600ms, EaseOut) { @from { $Trace.Opacity = 0; $Trace.TranslateX = -10; } @to { $Trace.Opacity = 1; $Trace.TranslateX = 0; } }
                @animate with Tween(800ms, EaseOut) { @from { $Caption.Opacity = 0; } @to { $Caption.Opacity = 1; } }
            }
        </MotionClip>
        <Aspect Name="SceneMotion" TargetType="reel:CyberProofScene">
            @handle Playback;
            @when $self.Visibility
            {
                @if value == Visible
                {
                    @run $Entrance as Playback;
                }
            }
        </Aspect>
    </UserControl.Resources>

    <Grid Margin="170,110,120,110">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Name="Kicker" Text="&gt; servo --autopilot" Aspect="$CyTag" Opacity="0" />
            <Grid Name="Headline" Margin="0,8,0,0" Opacity="0">
                <TextBlock Text="TESTS THAT CLICK. TOOLS THAT EXPLAIN." Aspect="$CyDisplay" FontSize="60" Foreground="$CyMagentaBrush" TranslateX="3" Opacity="0.85" />
                <TextBlock Text="TESTS THAT CLICK. TOOLS THAT EXPLAIN." Aspect="$CyDisplay" FontSize="60" Foreground="$CyCyanBrush" TranslateX="-3" Opacity="0.85" />
                <TextBlock Text="TESTS THAT CLICK. TOOLS THAT EXPLAIN." Aspect="$CyDisplay" FontSize="60" />
            </Grid>
        </StackPanel>

        <!-- The app under test. -->
        <Border Name="App" Grid.Row="1" Grid.Column="0" Aspect="$CyPanel" Padding="0" Width="442" Height="302" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,30,0,0" Opacity="0">
            <Grid Width="440" Height="300">
                <Border Height="40" Background="$CyGridBrush" VerticalAlignment="Top" />
                <TextBlock Text="ACCOUNT" Aspect="$CyHud" Foreground="$CyTextBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,12,0,0" />

                <TextBlock Text="NAME" Aspect="$CyHud" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,60,0,0" />
                <Border Aspect="$Field" Margin="24,80,0,0">
                    <TextBlock Text="Ada Lovelace" Aspect="$FieldText" />
                </Border>
                <TextBlock Text="EMAIL" Aspect="$CyHud" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,132,0,0" />
                <Border Aspect="$Field" Margin="24,152,0,0">
                    <TextBlock Text="ada@analytical.engine" Aspect="$FieldText" />
                </Border>

                <TextBlock Name="TargetId" Text="LOCK :: save-account" FontFamily="Cascadia Mono" FontSize="13" Foreground="$CyMagentaBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,202,0,0" Opacity="0" />
                <Border Name="SaveButton" Width="120" Height="40" Background="$CyCyanBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,228,0,0" RenderTransformOrigin="0.5,0.5">
                    <TextBlock Text="SAVE" FontFamily="Bahnschrift" FontSize="18" Foreground="$CyVoidBrush" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Name="Target" Width="134" Height="54" BorderBrush="$CyMagentaBrush" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,221,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5" />
                <TextBlock Name="Unsaved" Text="UNSAVED CHANGES" FontFamily="Cascadia Mono" FontSize="14" Foreground="$CyDimBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="168,238,0,0" />
                <TextBlock Name="Saved" Text="SAVED" FontFamily="Bahnschrift" FontSize="24" Foreground="$CyCyanBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="168,232,0,0" Opacity="0" />

                <Ellipse Name="Ripple" Width="40" Height="40" Fill="$CyMagentaBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,228,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5" />
                <Path
                    Name="Cursor"
                    Width="19"
                    Height="26"
                    Data="M 0 0 L 0 22 L 6 16 L 10 25 L 14 23 L 10 15 L 18 15 Z"
                    Fill="$CyMagentaBrush"
                    Stroke="$CyVoidBrush"
                    StrokeThickness="1.5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0" />
                <Border Name="Shutter" Background="$CyCyanBrush" Opacity="0" />
            </Grid>
        </Border>

        <!-- The Servo script, with the line being executed. -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="0,30,0,0">
            <Border Name="ScriptSheet" Aspect="$CyPanel" Padding="18,20,30,22" HorizontalAlignment="Left" Opacity="0">
                <StackPanel>
                    <TextBlock Text="SaveAccountTest.cs" Aspect="$CyHud" Margin="0,0,0,12" />
                    <Grid>
                        <Border Name="Marker" Width="4" Height="24" Background="$CyMagentaBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" Opacity="0" />
                        <StackPanel Name="Lines" Margin="16,0,0,0">
                            <TextBlock Text="Servo.SetId(save, &quot;save-account&quot;);" Aspect="$Script" />
                            <TextBlock Text="await servo.ClickAsync(ServoTarget.ById(&quot;save-account&quot;));" Aspect="$Script" />
                            <TextBlock Text="await servo.WaitForIdleAsync();" Aspect="$Script" />
                            <TextBlock Text="await servo.SaveScreenshotAsync(&quot;after-save.png&quot;);" Aspect="$Script" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Name="FrameTitle" Orientation="Horizontal" Margin="0,30,0,12" Opacity="0">
                <TextBlock Text="Detective.CaptureFrame()" FontFamily="Cascadia Mono" FontSize="16" Foreground="$CyTextBrush" />
                <TextBlock Text="TELEMETRY · FRAME AFTER THE CLICK · SAMPLE" Aspect="$CyHud" Margin="18,2,0,0" />
            </StackPanel>
            <StackPanel Name="Counters" Orientation="Horizontal">
                <Border Aspect="$Counter">
                    <StackPanel>
                        <TextBlock Text="4" Aspect="$CounterValue" />
                        <TextBlock Text="MeasuredElements" Aspect="$CounterName" />
                    </StackPanel>
                </Border>
                <Border Aspect="$Counter">
                    <StackPanel>
                        <TextBlock Text="4" Aspect="$CounterValue" />
                        <TextBlock Text="ArrangedElements" Aspect="$CounterName" />
                    </StackPanel>
                </Border>
                <Border Aspect="$Counter">
                    <StackPanel>
                        <TextBlock Text="12" Aspect="$CounterValue" />
                        <TextBlock Text="RenderedElements" Aspect="$CounterName" />
                    </StackPanel>
                </Border>
                <Border Aspect="$Counter">
                    <StackPanel>
                        <TextBlock Text="38" Aspect="$CounterValue" Foreground="$CyMagentaBrush" />
                        <TextBlock Text="ReusedCaches" Aspect="$CounterName" />
                    </StackPanel>
                </Border>
                <Border Aspect="$Counter">
                    <StackPanel>
                        <TextBlock Text="1" Aspect="$CounterValue" />
                        <TextBlock Text="MotionFrames" Aspect="$CounterName" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Name="Trace" Orientation="Horizontal" Margin="0,20,0,0" Opacity="0">
                <TextBlock Text="Detective.TraceAspect(save, Background)" FontFamily="Cascadia Mono" FontSize="16" Foreground="$CyTextBrush" />
                <TextBlock Text="// why does it have this value?" FontFamily="Cascadia Mono" FontSize="16" Foreground="$CyMagentaBrush" Margin="18,0,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Name="Caption"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Text="// Servo automates the app in-process through the real input pipeline, waiting on frames instead of sleeps. Detective explains every frame."
            Aspect="$CyLede"
            Opacity="0" />
    </Grid>
</UserControl>

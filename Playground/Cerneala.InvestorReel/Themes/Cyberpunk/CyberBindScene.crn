<!-- 07 · LIVE_DATA: packets burst along the worker bus, Relay folds them into one, and it lands on the UI bus as a single refresh. -->
<UserControl
    xmlns:reel="clr-namespace:Cerneala.InvestorReel"
    Aspect="$SceneMotion">
    <UserControl.Resources>
        <Tween Name="Arrive" Duration="420ms" Easing="EaseOut" />
        <Tween Name="Ping" Duration="200ms" Easing="EaseOut" />
        <Tween Name="Fold" Duration="420ms" Easing="EaseIn" />
        <Aspect Name="Packet" TargetType="Border">
            @default { Width = 12; Height = 12; Background = $CyVioletBrush; Margin = "0,0,14,0"; Opacity = 0; RenderTransformOrigin = "0.5,0.5"; }
        </Aspect>
        <Aspect Name="Code" TargetType="TextBlock">
            @default { FontFamily = "Cascadia Mono"; FontSize = 17; Foreground = $CyTextBrush; }
        </Aspect>
        <MotionClip Name="Entrance" TargetType="reel:CyberBindScene">
            @sequence
            {
                @parallel
                {
                    @animate with Tween(300ms, Linear) { @from { $Kicker.Opacity = 0; } @to { $Kicker.Opacity = 1; } }
                    @animate with Tween(160ms, Linear) { @from { $Headline.Opacity = 0; } @to { $Headline.Opacity = 1; } }
                    @animate with PingPong(Tween(45ms, Linear), 6) { @from { $Headline.TranslateX = 0; } @to { $Headline.TranslateX = 12; } }
                    @stagger target $Columns each 140ms
                    {
                        @animate with $Arrive { @from { Opacity = 0; TranslateY = 20; } @to { Opacity = 1; TranslateY = 0; } }
                    }
                }

                <!-- A burst on the worker bus... -->
                @stagger target $Burst each 80ms
                {
                    @animate with $Ping { @from { Opacity = 0; Scale = 0.2; } @to { Opacity = 1; Scale = 1; } }
                }
                <!-- ...folded by Relay into one pending refresh... -->
                @parallel
                {
                    @animate with $Fold { @from { $P1.TranslateX = 0; $P1.Opacity = 1; } @to { $P1.TranslateX = 182; $P1.Opacity = 0; } }
                    @animate with $Fold { @from { $P2.TranslateX = 0; $P2.Opacity = 1; } @to { $P2.TranslateX = 156; $P2.Opacity = 0; } }
                    @animate with $Fold { @from { $P3.TranslateX = 0; $P3.Opacity = 1; } @to { $P3.TranslateX = 130; $P3.Opacity = 0; } }
                    @animate with $Fold { @from { $P4.TranslateX = 0; $P4.Opacity = 1; } @to { $P4.TranslateX = 104; $P4.Opacity = 0; } }
                    @animate with $Fold { @from { $P5.TranslateX = 0; $P5.Opacity = 1; } @to { $P5.TranslateX = 78; $P5.Opacity = 0; } }
                    @animate with $Fold { @from { $P6.TranslateX = 0; $P6.Opacity = 1; } @to { $P6.TranslateX = 52; $P6.Opacity = 0; } }
                    @animate with $Fold { @from { $P7.TranslateX = 0; $P7.Opacity = 1; } @to { $P7.TranslateX = 26; $P7.Opacity = 0; } }
                    @animate with $Fold { @from { $P8.Opacity = 1; } @to { $P8.Opacity = 0; } }
                    @animate with $Fold { @from { $Refresh.Opacity = 0; $Refresh.Scale = 0.3; } @to { $Refresh.Opacity = 1; $Refresh.Scale = 1.3; } }
                    @animate with $Fold { @from { $Gate.Opacity = 0.35; } @to { $Gate.Opacity = 1; } }
                }
                <!-- ...that crosses to the UI thread and lands in the binding. -->
                @animate with Tween(320ms, EaseInOut) { @from { $Refresh.TranslateY = 0; } @to { $Refresh.TranslateY = 110; } }
                @animate with Tween(460ms, EaseInOut) { @from { $Refresh.TranslateX = 0; } @to { $Refresh.TranslateX = 220; } }
                @set { $Balance.Text = "1,268.75"; }
                @parallel
                {
                    @animate with Tween(160ms, EaseOut) { @from { $Refresh.Opacity = 1; } @to { $Refresh.Opacity = 0; } }
                    @animate with Tween(600ms, EaseOut) { @from { $Flash.Opacity = 1; } @to { $Flash.Opacity = 0; } }
                    @animate with Tween(400ms, EaseOut) { @from { $Gate.Opacity = 1; } @to { $Gate.Opacity = 0.35; } }
                    @animate with Tween(600ms, EaseOut) { @from { $Fold1.Opacity = 0; $Fold1.TranslateY = 8; } @to { $Fold1.Opacity = 1; $Fold1.TranslateY = 0; } }
                }

                <!-- Again: a bigger burst, still one refresh, always the latest value. -->
                @animate with Tween(16ms, Linear) { @from { $P1.TranslateX = 0; $P2.TranslateX = 0; $P3.TranslateX = 0; $P4.TranslateX = 0; $P5.TranslateX = 0; $P6.TranslateX = 0; $P7.TranslateX = 0; $Refresh.TranslateX = 0; $Refresh.TranslateY = 0; } @to { $P1.TranslateX = 0; $P2.TranslateX = 0; $P3.TranslateX = 0; $P4.TranslateX = 0; $P5.TranslateX = 0; $P6.TranslateX = 0; $P7.TranslateX = 0; $Refresh.TranslateX = 0; $Refresh.TranslateY = 0; } }
                @stagger target $Burst each 50ms
                {
                    @animate with $Ping { @from { Opacity = 0; Scale = 0.2; } @to { Opacity = 1; Scale = 1; } }
                }
                @parallel
                {
                    @animate with $Fold { @from { $P1.TranslateX = 0; $P1.Opacity = 1; } @to { $P1.TranslateX = 182; $P1.Opacity = 0; } }
                    @animate with $Fold { @from { $P2.TranslateX = 0; $P2.Opacity = 1; } @to { $P2.TranslateX = 156; $P2.Opacity = 0; } }
                    @animate with $Fold { @from { $P3.TranslateX = 0; $P3.Opacity = 1; } @to { $P3.TranslateX = 130; $P3.Opacity = 0; } }
                    @animate with $Fold { @from { $P4.TranslateX = 0; $P4.Opacity = 1; } @to { $P4.TranslateX = 104; $P4.Opacity = 0; } }
                    @animate with $Fold { @from { $P5.TranslateX = 0; $P5.Opacity = 1; } @to { $P5.TranslateX = 78; $P5.Opacity = 0; } }
                    @animate with $Fold { @from { $P6.TranslateX = 0; $P6.Opacity = 1; } @to { $P6.TranslateX = 52; $P6.Opacity = 0; } }
                    @animate with $Fold { @from { $P7.TranslateX = 0; $P7.Opacity = 1; } @to { $P7.TranslateX = 26; $P7.Opacity = 0; } }
                    @animate with $Fold { @from { $P8.Opacity = 1; } @to { $P8.Opacity = 0; } }
                    @animate with $Fold { @from { $Refresh.Opacity = 0; $Refresh.Scale = 0.3; } @to { $Refresh.Opacity = 1; $Refresh.Scale = 1.3; } }
                    @animate with $Fold { @from { $Gate.Opacity = 0.35; } @to { $Gate.Opacity = 1; } }
                }
                @animate with Tween(300ms, EaseInOut) { @from { $Refresh.TranslateY = 0; } @to { $Refresh.TranslateY = 110; } }
                @animate with Tween(420ms, EaseInOut) { @from { $Refresh.TranslateX = 0; } @to { $Refresh.TranslateX = 220; } }
                @set { $Balance.Text = "1,311.40"; }
                @parallel
                {
                    @animate with Tween(160ms, EaseOut) { @from { $Refresh.Opacity = 1; } @to { $Refresh.Opacity = 0; } }
                    @animate with Tween(600ms, EaseOut) { @from { $Flash.Opacity = 1; } @to { $Flash.Opacity = 0; } }
                    @animate with Tween(400ms, EaseOut) { @from { $Gate.Opacity = 1; } @to { $Gate.Opacity = 0.35; } }
                    @animate with Tween(800ms, EaseOut) { @from { $Caption.Opacity = 0; } @to { $Caption.Opacity = 1; } }
                }
            }
        </MotionClip>
        <Aspect Name="SceneMotion" TargetType="reel:CyberBindScene">
            @handle Playback;
            @when $self.Visibility
            {
                @if value == Visible
                {
                    @run $Entrance as Playback;
                }
            }
        </Aspect>
    </UserControl.Resources>

    <Grid Margin="140,120,140,110">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Name="Kicker" Text="&gt; bind --from-any-thread" Aspect="$CyTag" Opacity="0" />
            <Grid Name="Headline" Margin="0,8,0,0" Opacity="0">
                <TextBlock Text="BOUND ONCE. UPDATED FROM ANYWHERE." Aspect="$CyDisplay" FontSize="60" Foreground="$CyMagentaBrush" TranslateX="3" Opacity="0.85" />
                <TextBlock Text="BOUND ONCE. UPDATED FROM ANYWHERE." Aspect="$CyDisplay" FontSize="60" Foreground="$CyCyanBrush" TranslateX="-3" Opacity="0.85" />
                <TextBlock Text="BOUND ONCE. UPDATED FROM ANYWHERE." Aspect="$CyDisplay" FontSize="60" />
            </Grid>
        </StackPanel>

        <Grid Name="Columns" Grid.Row="1" Height="320" Margin="0,40,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- The contract -->
            <Border Grid.Column="0" Aspect="$CyPanel" VerticalAlignment="Top" Opacity="0">
                <StackPanel>
                    <TextBlock Text="LEDGER.CS" FontFamily="Cascadia Mono" FontSize="13" Foreground="$CyDimBrush" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="class " Aspect="$Code" Foreground="$CyCyanBrush" />
                        <TextBlock Text="Ledger : INotifyPropertyChanged" Aspect="$Code" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="26,4,0,0">
                        <TextBlock Text="decimal " Aspect="$Code" Foreground="$CyCyanBrush" />
                        <TextBlock Text="Balance { get; }" Aspect="$Code" />
                    </StackPanel>
                    <Border Height="1" Background="$CyGridBrush" Margin="0,18,0,16" />
                    <TextBlock Text="LEDGERVIEW.CRN" FontFamily="Cascadia Mono" FontSize="13" Foreground="$CyDimBrush" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Text=" Aspect="$Code" />
                        <TextBlock Text="&quot;\$DataContext.Balance:OneWay&quot;" Aspect="$Code" Foreground="$CyMagentaBrush" />
                    </StackPanel>
                    <TextBlock Text="ROSLYN RESOLVES EVERY PATH AT BUILD · NO REFLECTION" FontFamily="Cascadia Mono" FontSize="12" Foreground="$CyDimBrush" Margin="0,18,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Two buses -->
            <Grid Grid.Column="1" Width="460" Height="280" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
                <TextBlock Text="WORKER THREAD" FontFamily="Cascadia Mono" FontSize="13" Foreground="$CyVioletBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0" />
                <Border Height="2" Background="$CyVioletBrush" VerticalAlignment="Top" Margin="20,66,20,0" Opacity="0.5" />
                <StackPanel Name="Burst" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,61,0,0">
                    <Border Name="P1" Aspect="$Packet" />
                    <Border Name="P2" Aspect="$Packet" />
                    <Border Name="P3" Aspect="$Packet" />
                    <Border Name="P4" Aspect="$Packet" />
                    <Border Name="P5" Aspect="$Packet" />
                    <Border Name="P6" Aspect="$Packet" />
                    <Border Name="P7" Aspect="$Packet" />
                    <Border Name="P8" Aspect="$Packet" />
                </StackPanel>
                <Border Name="Gate" Width="44" Height="150" BorderBrush="$CyMagentaBrush" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="186,40,0,0" Opacity="0.35" />
                <TextBlock Text="RELAY" FontFamily="Cascadia Mono" FontSize="12" Foreground="$CyMagentaBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="188,196,0,0" />
                <TextBlock Text="UI THREAD" FontFamily="Cascadia Mono" FontSize="13" Foreground="$CyCyanBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,130,0,0" />
                <Border Height="2" Background="$CyCyanBrush" VerticalAlignment="Top" Margin="20,176,20,0" />
                <Border Name="Refresh" Width="16" Height="16" Background="$CyMagentaBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,59,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5" />
                <TextBlock Name="Fold1" Text="a burst becomes one refresh" FontFamily="Cascadia Mono" FontSize="15" Foreground="$CyMagentaBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,236,0,0" Opacity="0" />
            </Grid>

            <!-- The bound value -->
            <Border Grid.Column="2" Aspect="$CyPanel" Padding="0" Height="190" VerticalAlignment="Top" Margin="0,70,0,0" Opacity="0">
                <Grid>
                    <Border Name="Flash" Background="$CyMagentaWashBrush" Opacity="0" />
                    <StackPanel Margin="30,24,30,26">
                        <TextBlock Text="BALANCE · LEI" FontFamily="Cascadia Mono" FontSize="13" Foreground="$CyDimBrush" />
                        <TextBlock Name="Balance" Text="1,204.20" FontFamily="Bahnschrift" FontSize="58" Foreground="$CyTextBrush" Margin="0,8,0,0" />
                        <TextBlock Text="bound to Ledger.Balance" FontFamily="Cascadia Mono" FontSize="14" Foreground="$CyCyanBrush" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            Name="Caption"
            Grid.Row="2"
            Text="// Raise PropertyChanged from any thread: Relay gathers the burst and refreshes the binding once, on the UI thread."
            Aspect="$CyLede"
            Opacity="0" />
    </Grid>
</UserControl>

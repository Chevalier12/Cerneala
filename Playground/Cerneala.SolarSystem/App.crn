<!-- Palette, gradients, starfields and shading brushes for the orrery. Gradient centres and radii are in pixels of the element they fill. -->
<Application
    StartupWindow="MainWindow"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Palette -->
        <SolidColorBrush Name="SpaceBrush" Color="#FF03040A" />
        <SolidColorBrush Name="ClearBrush" Color="#00000000" />
        <SolidColorBrush Name="WhiteBrush" Color="#FFFFFFFF" />
        <SolidColorBrush Name="HudTextBrush" Color="#CCE6ECF5" />
        <SolidColorBrush Name="HudDimBrush" Color="#8098A3B8" />
        <SolidColorBrush Name="AccentBrush" Color="#FFFFC870" />
        <SolidColorBrush Name="AccentWashBrush" Color="#33FFC870" />
        <SolidColorBrush Name="CoolBrush" Color="#FF8FD6FF" />
        <SolidColorBrush Name="GlassBrush" Color="#B80A0F1C" />
        <SolidColorBrush Name="GlassButtonBrush" Color="#590E1526" />
        <SolidColorBrush Name="GlassHotBrush" Color="#991A2540" />
        <SolidColorBrush Name="GlassLineBrush" Color="#2EFFFFFF" />
        <SolidColorBrush Name="OrbitBrush" Color="#1FBFD4FF" />
        <SolidColorBrush Name="OrbitHotBrush" Color="#8CFFD79A" />
        <SolidColorBrush Name="HoverBrush" Color="#CCFFFFFF" />
        <SolidColorBrush Name="SelectBrush" Color="#FFFFC870" />

        <!-- The Sun: a corona that fades into space, a warm glow, a streak, and the photosphere. -->
        <RadialGradientBrush Name="CoronaBrush" Center="550,550" RadiusX="550" RadiusY="550">
            <GradientStop Offset="0" Color="#66FFB45C" />
            <GradientStop Offset="0.1" Color="#40FFA048" />
            <GradientStop Offset="0.28" Color="#1AFF8A38" />
            <GradientStop Offset="0.55" Color="#08FF7030" />
            <GradientStop Offset="1" Color="#00FF6020" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="SunGlowBrush" Center="190,190" RadiusX="190" RadiusY="190">
            <GradientStop Offset="0" Color="#FFFFF6D8" />
            <GradientStop Offset="0.3" Color="#E6FFD27A" />
            <GradientStop Offset="0.55" Color="#59FFA04A" />
            <GradientStop Offset="1" Color="#00FF8A30" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="StreakBrush" Center="520,5" RadiusX="520" RadiusY="5">
            <GradientStop Offset="0" Color="#B3FFE7B8" />
            <GradientStop Offset="0.4" Color="#33FFC890" />
            <GradientStop Offset="1" Color="#00FFB070" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="PhotosphereBrush" Center="66,66" RadiusX="66" RadiusY="66">
            <GradientStop Offset="0" Color="#FFFFFDF2" />
            <GradientStop Offset="0.45" Color="#FFFFE7A0" />
            <GradientStop Offset="0.82" Color="#FFFFB547" />
            <GradientStop Offset="1" Color="#FFF07A26" />
        </RadialGradientBrush>

        <!-- Planet surfaces: albedo only. Day and night come from the shade overlays below. -->
        <RadialGradientBrush Name="MercurySurface" Center="5,5" RadiusX="5" RadiusY="5">
            <GradientStop Offset="0" Color="#FFD9D3CB" /><GradientStop Offset="0.7" Color="#FFA39C93" /><GradientStop Offset="1" Color="#FF6E6861" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="VenusSurface" Center="9,9" RadiusX="9" RadiusY="9">
            <GradientStop Offset="0" Color="#FFFFF5DA" /><GradientStop Offset="0.7" Color="#FFEBCB8E" /><GradientStop Offset="1" Color="#FFBF9558" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="EarthSurface" Center="9.5,9.5" RadiusX="9.5" RadiusY="9.5">
            <GradientStop Offset="0" Color="#FF5FAEF5" /><GradientStop Offset="0.75" Color="#FF2A66BC" /><GradientStop Offset="1" Color="#FF16407E" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="MarsSurface" Center="6.5,6.5" RadiusX="6.5" RadiusY="6.5">
            <GradientStop Offset="0" Color="#FFF0A57C" /><GradientStop Offset="0.7" Color="#FFC65C33" /><GradientStop Offset="1" Color="#FF86331A" />
        </RadialGradientBrush>
        <LinearGradientBrush Name="JupiterSurface" StartPoint="0,0" EndPoint="0,52">
            <GradientStop Offset="0" Color="#FFB89E82" />
            <GradientStop Offset="0.12" Color="#FFE8D9C0" />
            <GradientStop Offset="0.2" Color="#FFC2875C" />
            <GradientStop Offset="0.28" Color="#FFF3E6CF" />
            <GradientStop Offset="0.38" Color="#FFD7A577" />
            <GradientStop Offset="0.46" Color="#FFF6EBD6" />
            <GradientStop Offset="0.55" Color="#FFB97A50" />
            <GradientStop Offset="0.63" Color="#FFEEDCC0" />
            <GradientStop Offset="0.72" Color="#FFC99568" />
            <GradientStop Offset="0.82" Color="#FFE9D7BC" />
            <GradientStop Offset="0.9" Color="#FFB8987A" />
            <GradientStop Offset="1" Color="#FF8F7A66" />
        </LinearGradientBrush>
        <LinearGradientBrush Name="SaturnSurface" StartPoint="0,0" EndPoint="0,44">
            <GradientStop Offset="0" Color="#FFC9B48C" />
            <GradientStop Offset="0.18" Color="#FFF2E2B8" />
            <GradientStop Offset="0.32" Color="#FFDCC294" />
            <GradientStop Offset="0.5" Color="#FFF6E8C4" />
            <GradientStop Offset="0.64" Color="#FFD8BB88" />
            <GradientStop Offset="0.8" Color="#FFEEDCB0" />
            <GradientStop Offset="1" Color="#FFAE9670" />
        </LinearGradientBrush>
        <RadialGradientBrush Name="UranusSurface" Center="14,14" RadiusX="14" RadiusY="14">
            <GradientStop Offset="0" Color="#FFDDFCFF" /><GradientStop Offset="0.7" Color="#FF96DCE8" /><GradientStop Offset="1" Color="#FF5AA4B6" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="NeptuneSurface" Center="13.5,13.5" RadiusX="13.5" RadiusY="13.5">
            <GradientStop Offset="0" Color="#FF9DBEFF" /><GradientStop Offset="0.7" Color="#FF4068DA" /><GradientStop Offset="1" Color="#FF22348C" />
        </RadialGradientBrush>
        <SolidColorBrush Name="MoonSurface" Color="#FFD3CEC6" />
        <SolidColorBrush Name="ContinentBrush" Color="#CC5E8F4A" />
        <SolidColorBrush Name="CloudBrush" Color="#B3FFFFFF" />
        <SolidColorBrush Name="SpotBrush" Color="#D9C0563A" />
        <SolidColorBrush Name="PolarBrush" Color="#E6FFF6F0" />
        <SolidColorBrush Name="CraterBrush" Color="#4D2E2A26" />
        <SolidColorBrush Name="StormBrush" Color="#991B2466" />
        <SolidColorBrush Name="RingInnerBrush" Color="#99C9B48A" />
        <SolidColorBrush Name="RingMainBrush" Color="#D9E3D1A8" />
        <SolidColorBrush Name="RingOuterBrush" Color="#66BBA97F" />
        <SolidColorBrush Name="FaintRingBrush" Color="#409FE8F0" />

        <!-- Flare ghosts -->
        <RadialGradientBrush Name="GhostWarmBrush" Center="40,40" RadiusX="40" RadiusY="40">
            <GradientStop Offset="0" Color="#00FFC080" /><GradientStop Offset="0.7" Color="#1AFFC080" /><GradientStop Offset="0.9" Color="#33FFD8A0" /><GradientStop Offset="1" Color="#00FFD8A0" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="GhostCoolBrush" Center="70,70" RadiusX="70" RadiusY="70">
            <GradientStop Offset="0" Color="#148FD6FF" /><GradientStop Offset="0.8" Color="#0F8FD6FF" /><GradientStop Offset="1" Color="#008FD6FF" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="GhostDotBrush" Center="12,12" RadiusX="12" RadiusY="12">
            <GradientStop Offset="0" Color="#66FFE6C0" /><GradientStop Offset="1" Color="#00FFE6C0" />
        </RadialGradientBrush>

        <!-- Nebula clouds and the frame vignette -->
        <RadialGradientBrush Name="NebulaVioletBrush" Center="760,460" RadiusX="760" RadiusY="460">
            <GradientStop Offset="0" Color="#7A5B3A9E" /><GradientStop Offset="0.45" Color="#333A2470" /><GradientStop Offset="1" Color="#001A1040" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="NebulaTealBrush" Center="560,340" RadiusX="560" RadiusY="340">
            <GradientStop Offset="0" Color="#661E6C80" /><GradientStop Offset="0.5" Color="#240E3C4C" /><GradientStop Offset="1" Color="#00061C24" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="NebulaRoseBrush" Center="560,340" RadiusX="560" RadiusY="340">
            <GradientStop Offset="0" Color="#66B0446E" /><GradientStop Offset="0.5" Color="#26701E48" /><GradientStop Offset="1" Color="#00300A20" />
        </RadialGradientBrush>
        <RadialGradientBrush Name="VignetteBrush" Center="680,382" RadiusX="940" RadiusY="640">
            <GradientStop Offset="0" Color="#00000000" /><GradientStop Offset="0.55" Color="#00000000" /><GradientStop Offset="1" Color="#D9000000" />
        </RadialGradientBrush>
        <DrawingBrush Name="StarsFarBrush" ContentBounds="0,0,600,600" TileMode="Tile" Viewport="0,0,600,600" Stretch="None" AlignmentX="Left" AlignmentY="Top">
            <FillEllipse Rect="273.5,542.3,1.49,1.49" Color="#60BFD6FF" />

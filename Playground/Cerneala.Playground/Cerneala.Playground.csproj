<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\Assets\cerneala-playground.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cerneala.csproj" />
    <ProjectReference Include="..\..\Cerneala.Scene2D.Packages\Cerneala.Scene2D.Packages.csproj" />
    <ProjectReference Include="..\..\Tools\Cerneala.Scene2D.PackageCompiler\Cerneala.Scene2D.PackageCompiler.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="_ScenePackageCompiler" />
    <ProjectReference Include="..\..\Cerneala.Backends.SdlGpu\Cerneala.Backends.SdlGpu.csproj" />
    <ProjectReference Include="..\..\Cerneala.SourceGen\Cerneala.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="**\*.crn" Exclude="bin\**;obj\**" />
    <Content Include="..\Assets\fxemoji.svg" Link="fxemoji.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs-site\assets\cerneala-mascot-void-suction-well.png"
             Link="drawing-api-mascot.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="SceneWorldPackages.targets" />
</Project>

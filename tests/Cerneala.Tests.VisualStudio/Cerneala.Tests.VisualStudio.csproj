<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Cerneala.VisualStudio\Server\CernealaServerProcessManager.cs"
             Link="Server\CernealaServerProcessManager.cs" />
    <Compile Include="..\..\Cerneala.VisualStudio\Server\SystemCernealaServerProcess.cs"
             Link="Server\SystemCernealaServerProcess.cs" />
  </ItemGroup>

  <Target Name="BuildVisualStudioExtension"
          BeforeTargets="Build"
          Condition="'$(SkipVisualStudioExtensionBuild)' != 'true'">
    <MSBuild
      Projects="..\..\Cerneala.VisualStudio\Cerneala.VisualStudio.csproj;..\Fixtures\VisualStudioIntegrationHost\VisualStudioIntegrationHost.csproj"
      Targets="Build"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>

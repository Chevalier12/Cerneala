<!-- Cerneala grammar corpus -->
<UserControl xmlns:ui="clr-namespace:Sample" x:DataType="ui:MainViewModel">
  <Grid.Resources>
    <PrismComposition Name="GlowFx">
      @parameter Radius: float = 4;
      @layer Glow
      {
        @filter Blur { Radius = $root.BlurRadius; }
      }
    </PrismComposition>
  </Grid.Resources>
  <MotionClip Name="Reveal">
    @sequence
    {
      @animate with Tween(120ms)
      {
        @from { $self.Opacity = 0; }
        @to { $self.Opacity = 1; }
      }
    }
  </MotionClip>
  <TextBlock Text="$DataContext.Title:OneWay" Foreground="$AccentBrush" />
  <Button Content="{Binding SaveLabel}" />
  <Broken Attribute="
  <Border>
    @prism $GlowFx(Radius = 12);
  </Border>
  &lt;escaped&gt;
  <StackPanel.Resources>
    <SoundClip Name="Tone">
      Source = "audio/tone.wav"; Loop = false;
      @parameter Cut: float = 900;
      @modifier LowPass { Cutoff = Cut; }
    </SoundClip>
  </StackPanel.Resources>
  <Button.Aspect>
    @handle Playback;
    @on Click { @sound $Tone(Volume = 0.5) as Playback; @pause Playback; }
    @when IsPressed { @resume Playback; @seek Playback to 30s; }
  </Button.Aspect>
</UserControl>

<!-- Cerneala grammar corpus -->
<UserControl xmlns:ui="clr-namespace:Sample" x:DataType="ui:MainViewModel">
  <Grid.Resources>
    <PrismClip Name="GlowFx">
      @parameter Radius: float = 4;
      @layer Glow
      {
        @filter Blur { Radius = $root.BlurRadius; }
      }
    </PrismClip>
  </Grid.Resources>
  <MotionClip Name="Reveal">
    @sequence
    {
      @animate with Tween(120ms)
      {
        @from { $self.Opacity = 0; }
        @to { $self.Opacity = 1; }
      }
    }
  </MotionClip>
  <TextBlock Text="$DataContext.Title:OneWay" Foreground="$AccentBrush" />
  <Button Content="{Binding SaveLabel}" />
  <Broken Attribute="
  <Border>
    <Border.Aspect>
      @prism $GlowFx(Radius = 12);
    </Border.Aspect>
  </Border>
  &lt;escaped&gt;
  <StackPanel.Resources>
    <TimbreClip Name="Tone">
      @parameter Cut: float = 900;
      @sound Tone { Source = "audio/tone.wav"; Loop = false; @modifier LowPass { Cutoff = Cut; } }
    </TimbreClip>
  </StackPanel.Resources>
  <Button.Aspect>
    @timbre $Tone(Cut = 400);
    @on Click { @play $self.timbre.Tone; @pause $self.timbre.Tone; }
    @when IsPressed { @resume $self.timbre.Tone; @seek $self.timbre.Tone to 30s; @stop $self.timbre.Tone; }
  </Button.Aspect>
</UserControl>

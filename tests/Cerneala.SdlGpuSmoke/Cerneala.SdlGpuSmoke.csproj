<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cerneala.csproj" />
    <ProjectReference Include="..\..\Cerneala.Backends.SdlGpu\Cerneala.Backends.SdlGpu.csproj" />
    <ProjectReference Include="..\..\Cerneala.SourceGen\Cerneala.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="**\*.crn" Exclude="bin\**;obj\**" />
    <Compile Include="..\Shared\TileMapStage3CaptureFixture.cs" Link="TileMapStage3CaptureFixture.cs" />
    <Compile Include="..\Shared\TileMapStage5ConformanceFixture.cs" Link="TileMapStage5ConformanceFixture.cs" />
    <Compile Include="..\Shared\CollisionStageFiveFixture.cs" Link="CollisionStageFiveFixture.cs" />
    <Compile Include="..\Shared\SpriteAnimationConformanceFixture.cs" Link="SpriteAnimationConformanceFixture.cs" />
    <Compile Include="..\Shared\SceneDebugOverlayConformanceFixture.cs" Link="SceneDebugOverlayConformanceFixture.cs" />
    <Compile Include="..\Shared\RenderSurface3DConformanceFixture.cs" Link="RenderSurface3DConformanceFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Timbre smoke fixtures from the decoder corpus (provenance in its corpus-manifest.json). -->
    <None Include="..\Cerneala.Tests.Timbre\Corpus\mp3-mpeg1-44100-stereo-cbr128.mp3" Link="timbre\mp3-mpeg1-44100-stereo-cbr128.mp3" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Cerneala.Tests.Timbre\Corpus\vorbis-48000-stereo-q2.ogg" Link="timbre\vorbis-48000-stereo-q2.ogg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Cerneala.Tests.Timbre\Corpus\opus-stereo-48000-96k.opus" Link="timbre\opus-stereo-48000-96k.opus" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Cerneala.Tests.Timbre\Corpus\mp3-long-22050-mono-cbr64.mp3" Link="timbre\mp3-long-22050-mono-cbr64.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

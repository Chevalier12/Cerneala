<UserControl>
    <UserControl.Resources>
        <TimbreClip Name="Wav">@sound Wav { Source = "timbre/markup-tone-44100.wav"; }</TimbreClip>
        <TimbreClip Name="Mp3">@sound Mp3 { Source = "timbre/mp3-mpeg1-44100-stereo-cbr128.mp3"; }</TimbreClip>
        <TimbreClip Name="Vorbis">@sound Vorbis { Source = "timbre/vorbis-48000-stereo-q2.ogg"; }</TimbreClip>
        <TimbreClip Name="Opus">@sound Opus { Source = "timbre/opus-stereo-48000-96k.opus"; }</TimbreClip>
        <TimbreClip Name="Filtered">
            @parameter ToneCutoff: float = 1200;
            @sound Filtered
            {
                Source = "timbre/markup-tone-44100.wav";
                Volume = 0.8;
                @modifier LowPass { Cutoff = ToneCutoff; }
                @modifier Delay { Time = 120ms; Feedback = 0.2; Mix = 0.15; }
            }
        </TimbreClip>
    </UserControl.Resources>
    <StackPanel Margin="12">
        <StackPanel Orientation="Horizontal">
            <Button Servo.Id="play-wav" Content="WAV" Width="90" Height="36" Margin="0,0,6,6">
                <Button.Aspect>@timbre $Wav; @on Click { @play $self.timbre.Wav; }</Button.Aspect>
            </Button>
            <Button Servo.Id="play-mp3" Content="MP3" Width="90" Height="36" Margin="0,0,6,6">
                <Button.Aspect>@timbre $Mp3; @on Click { @play $self.timbre.Mp3; }</Button.Aspect>
            </Button>
            <Button Servo.Id="play-vorbis" Content="Vorbis" Width="90" Height="36" Margin="0,0,6,6">
                <Button.Aspect>@timbre $Vorbis; @on Click { @play $self.timbre.Vorbis; }</Button.Aspect>
            </Button>
            <Button Servo.Id="play-opus" Content="Opus" Width="90" Height="36" Margin="0,0,6,6">
                <Button.Aspect>@timbre $Opus; @on Click { @play $self.timbre.Opus; }</Button.Aspect>
            </Button>
            <Button Servo.Id="play-filtered" Content="Filtered" Width="90" Height="36" Margin="0,0,6,6">
                <Button.Aspect>@timbre $Filtered(ToneCutoff = 800); @on Click { @play $self.timbre.Filtered; }</Button.Aspect>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <CheckBox Name="PlayBox" Servo.Id="transport-play" Content="Play" Margin="0,0,10,6" />
            <CheckBox Name="PauseBox" Servo.Id="transport-pause" Content="Pause" Margin="0,0,10,6" />
            <CheckBox Name="SeekBox" Servo.Id="transport-seek" Content="Seek 60s" Margin="0,0,10,6" />
            <CheckBox Name="StopBox" Servo.Id="transport-stop" Content="Stop" Margin="0,0,10,6" />
            <CheckBox Name="LoopBox" Servo.Id="loop-play" Content="Loop" Margin="0,0,10,6" />
            <CheckBox Name="LoopStopBox" Servo.Id="loop-stop" Content="Loop stop" Margin="0,0,10,6" />
        </StackPanel>
        <Border Name="Transport" Height="24">
            <Border.Aspect>
                @timbre
                {
                    @sound Music { Source = "timbre/mp3-long-22050-mono-cbr64.mp3"; }
                    @sound Looper { Source = "timbre/markup-tone-44100.wav"; Loop = true; }
                }
                @when $PlayBox.IsChecked { @if $PlayBox.IsChecked == true { @play $self.timbre.Music; } }
                @when $PauseBox.IsChecked
                {
                    @if $PauseBox.IsChecked == true { @pause $self.timbre.Music; }
                    @if $PauseBox.IsChecked == false { @resume $self.timbre.Music; }
                }
                @when $SeekBox.IsChecked { @if $SeekBox.IsChecked == true { @seek $self.timbre.Music to 60s; } }
                @when $StopBox.IsChecked { @if $StopBox.IsChecked == true { @stop $self.timbre.Music; } }
                @when $LoopBox.IsChecked { @if $LoopBox.IsChecked == true { @play $self.timbre.Looper; } }
                @when $LoopStopBox.IsChecked { @if $LoopStopBox.IsChecked == true { @stop $self.timbre.Looper; } }
            </Border.Aspect>
        </Border>
    </StackPanel>
</UserControl>

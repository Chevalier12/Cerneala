<UserControl xmlns:consumer="clr-namespace:VisualStudioConsumer">
    <UserControl.Resources>
        <PrismClip Name="AuthoringFx">
            @parameter Radius: float = 3;
            @layer Main
            {
                @filter Blur { Radius = 3; }
            }
        </PrismClip>
    </UserControl.Resources>
    <StackPanel>
        <consumer:StatusCard Status="Authoring" Text="Ready" />
        <TextBlock Name="CompletionAnchor" Text="Completion target" />
        <Border>
            <Border.Aspect>
                @prism $AuthoringFx(Radius = 6);
            </Border.Aspect>
        </Border>
    </StackPanel>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <_CernealaExcludedDirectories>
      docs\**;
      Cerneala.SourceGen\**;
      Cerneala.Scene2D.Importers\**;
      Cerneala.Scene2D.Packages\**;
      Cerneala.Backends.SdlGpu\**;
      Cerneala.Platforms.Sdl3\**;
      Cerneala.Language\**;
      Cerneala.LanguageServer\**;
      Cerneala.PreviewHost\**;
      Cerneala.VisualStudio\**;
      Shared\**;
      Playground\**;
      CernealaPresentation\**;
      benchmarks\**;
      Tools\**;
      tests\**;
      Tetrisish\**
    </_CernealaExcludedDirectories>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(_CernealaExcludedDirectories)" />
    <EmbeddedResource Remove="$(_CernealaExcludedDirectories)" />
    <None Remove="$(_CernealaExcludedDirectories)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" Version="14.2.0" />
    <PackageReference Include="LibTessDotNet" Version="1.1.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Cerneala.SourceGen\Cerneala.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="**\*.crn" Exclude="bin\**;obj\**;Cerneala.Language\**;Cerneala.LanguageServer\**;Cerneala.PreviewHost\**;Cerneala.SourceGen\**;Cerneala.Scene2D.Importers\**;Cerneala.Scene2D.Packages\**;CernealaPresentation\**;docs\**;Playground\**;Shared\**;Tetrisish\**;Tools\**;tests\**" />
    <AdditionalFiles Include="Cerneala.SourceGen\Prism\Catalog\prism-catalog.json" />
    <EmbeddedResource Include="Drawing\Prism\Filters\Assets\bluenoise.bin">
      <LogicalName>Cerneala.Drawing.Prism.Filters.Assets.bluenoise.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Drawing\Prism\Blend\Assets\dissolve-fastnoise-ranks.bin">
      <LogicalName>Cerneala.Drawing.Prism.Blending.Assets.dissolve-fastnoise-ranks.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
